---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, any>;
}

const { title, description, canonicalUrl, jsonLd } = Astro.props;
const siteName = "ToolsRadar";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Schema.org JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <style is:global>
      :root {
        --bg-main: #09090b;
        --surface: #121215;
        --surface-hover: #18181d;
        --border-subtle: rgba(255, 255, 255, 0.08);
        --border-hover: rgba(56, 189, 248, 0.35);
        --text-primary: #f4f4f5;
        --text-secondary: #a1a1aa;
        --text-muted: #71717a;
        --accent: #38bdf8;
        --accent-glow: rgba(56, 189, 248, 0.15);
        --emerald: #10b981;
        --emerald-glow: rgba(16, 185, 129, 0.15);
        --purple: #a855f7;
        --font-sans: -apple-system, BlinkMacSystemFont, "Geist", "Inter", "Segoe UI", Roboto, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--bg-main);
        color: var(--text-primary);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background-image: 
          radial-gradient(at 50% 0%, rgba(56, 189, 248, 0.08) 0px, transparent 50%),
          radial-gradient(at 100% 0%, rgba(168, 85, 247, 0.05) 0px, transparent 40%);
        background-attachment: fixed;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: all 0.15s ease;
      }

      a:hover {
        color: #7dd3fc;
      }

      .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 1.75rem 1.25rem;
        width: 100%;
      }

      /* Navbar */
      .navbar {
        border-bottom: 1px solid var(--border-subtle);
        background-color: rgba(9, 9, 11, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .nav-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 1.25rem;
        max-width: 1140px;
        margin: 0 auto;
      }

      .nav-brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-primary);
        text-decoration: none;
        letter-spacing: -0.02em;
      }

      .nav-brand-icon {
        width: 28px;
        height: 28px;
        background: linear-gradient(135deg, #38bdf8 0%, #a855f7 100%);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        box-shadow: 0 0 12px rgba(56, 189, 248, 0.3);
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        list-style: none;
      }

      .nav-links a {
        color: var(--text-secondary);
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.15s ease;
      }

      .nav-links a:hover {
        color: var(--text-primary);
      }

      /* Live Breathing Status Pill */
      .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: #6ee7b7;
        padding: 0.3rem 0.8rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .live-dot {
        width: 7px;
        height: 7px;
        background-color: var(--emerald);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--emerald);
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1.1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
      }

      /* Gradient Text */
      .gradient-title {
        background: linear-gradient(180deg, #ffffff 20%, #a1a1aa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.04em;
        font-weight: 800;
      }

      .gradient-accent {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #c084fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* Search Bar */
      .search-box-wrapper {
        position: relative;
        max-width: 580px;
        margin: 1.75rem auto 0;
      }

      .search-input {
        width: 100%;
        background-color: rgba(24, 24, 27, 0.7);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: 0.85rem 1.25rem 0.85rem 2.85rem;
        color: var(--text-primary);
        font-size: 0.95rem;
        outline: none;
        backdrop-filter: blur(8px);
        transition: all 0.2s ease;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
      }

      .search-input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15), 0 8px 30px rgba(0, 0, 0, 0.4);
        background-color: #18181b;
      }

      .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        pointer-events: none;
      }

      .search-shortcut {
        position: absolute;
        right: 0.85rem;
        top: 50%;
        transform: translateY(-50%);
        background: #27272a;
        border: 1px solid #3f3f46;
        color: #a1a1aa;
        font-size: 0.7rem;
        font-family: var(--font-mono);
        padding: 0.2rem 0.45rem;
        border-radius: 5px;
      }

      /* Card Anatomy */
      .tools-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        margin-top: 2rem;
      }

      @media (min-width: 768px) {
        .tools-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .tool-card {
        background: linear-gradient(180deg, rgba(24, 24, 27, 0.7) 0%, rgba(18, 18, 20, 0.8) 100%);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
      }

      .tool-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12), transparent);
      }

      .tool-card:hover {
        transform: translateY(-3px);
        border-color: var(--border-hover);
        box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.5), 0 0 20px -3px var(--accent-glow);
        background: linear-gradient(180deg, rgba(28, 28, 32, 0.85) 0%, rgba(20, 20, 24, 0.95) 100%);
      }

      .tool-card-top {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        margin-bottom: 0.85rem;
      }

      .tool-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: #27272a;
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
      }

      .tool-icon img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .tool-icon-fallback {
        font-size: 1.15rem;
        font-weight: 700;
        color: #e4e4e7;
        text-transform: uppercase;
      }

      .tool-meta-header {
        flex-grow: 1;
        min-width: 0;
      }

      .tool-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
      }

      .tool-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.01em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .tool-tagline {
        color: var(--text-secondary);
        font-size: 0.88rem;
        line-height: 1.5;
        margin-top: 0.35rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .tool-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 0.85rem;
        margin-top: 0.85rem;
        font-size: 0.8rem;
      }

      /* Badges */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        letter-spacing: 0.02em;
      }

      .badge-oss {
        background: rgba(16, 185, 129, 0.12);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.25);
      }

      .badge-free {
        background: rgba(56, 189, 248, 0.12);
        color: #7dd3fc;
        border: 1px solid rgba(56, 189, 248, 0.25);
      }

      .badge-source {
        background: rgba(255, 255, 255, 0.05);
        color: #d4d4d8;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .stars-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #fbbf24;
        background: rgba(251, 191, 36, 0.1);
        border: 1px solid rgba(251, 191, 36, 0.2);
        padding: 0.18rem 0.5rem;
        border-radius: 9999px;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.55rem 1.1rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .btn-primary {
        background: #f4f4f5;
        color: #09090b;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
      }

      .btn-primary:hover {
        background: #ffffff;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
      }

      .btn-secondary {
        background: rgba(255, 255, 255, 0.06);
        color: #f4f4f5;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.2);
      }

      /* Footer */
      .footer {
        border-top: 1px solid var(--border-subtle);
        margin-top: auto;
        padding: 3rem 1.25rem;
        background-color: #070709;
        font-size: 0.875rem;
        color: var(--text-muted);
      }

      .footer-container {
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
        text-align: center;
      }

      @media (min-width: 640px) {
        .footer-container {
          flex-direction: row;
          justify-content: space-between;
          text-align: left;
        }
      }

      .footer-links {
        display: flex;
        gap: 1.5rem;
      }

      .footer-links a {
        color: var(--text-secondary);
      }

      .footer-links a:hover {
        color: var(--text-primary);
      }
    </style>
  </head>
  <body>
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="nav-brand">
          <div class="nav-brand-icon">⚡</div>
          <span>ToolsRadar</span>
        </a>
        <nav>
          <ul class="nav-links">
            <li><a href="/">Radar</a></li>
            <li><a href="/category/ai-tools">AI Tools</a></li>
            <li><a href="/category/developer-tools">DevTools</a></li>
            <li><a href="/category/open-source">Open Source</a></li>
            <li><a href="/about">About</a></li>
            <li>
              <a 
                href="https://github.com/cj1357/tools-radar" 
                target="_blank" 
                rel="noopener noreferrer"
                style="display: flex; align-items: center; gap: 0.35rem; background: rgba(255, 255, 255, 0.06); padding: 0.3rem 0.65rem; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.1);"
              >
                <svg height="14" width="14" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
                </svg>
                GitHub
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-container">
        <div>
          <p>© {new Date().getFullYear()} ToolsRadar.dev — Curating the world's best new developer tools.</p>
          <p style="margin-top: 0.35rem; color: #52525b;">Automated daily crawling across GitHub Trending, Hacker News & Product Hunt.</p>
        </div>
        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/privacy">Privacy Policy</a>
          <a href="/">Categories</a>
          <a href="https://github.com/cj1357/tools-radar" target="_blank" rel="noopener noreferrer">Source Code</a>
        </div>
      </div>
    </footer>
  </body>
</html>
