---
import Layout from '../../layouts/Layout.astro';
import { guidesData, type GuideArticle } from '../../data/guides';

export function getStaticPaths() {
  return guidesData.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GuideArticle;
}

const { guide } = Astro.props;

const relatedGuides = guidesData
  .filter((g) => g.slug !== guide.slug)
  .slice(0, 2);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": guide.title,
  "description": guide.description,
  "datePublished": guide.publishedAt,
  "dateModified": guide.updatedAt,
  "author": {
    "@type": "Person",
    "name": guide.author.name,
    "jobTitle": guide.author.role
  },
  "publisher": {
    "@type": "Organization",
    "name": "ToolsRadar",
    "url": "https://lordorange.top",
    "logo": "https://lordorange.top/favicon.svg"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://lordorange.top/guides/${guide.slug}`
  }
};
---

<Layout
  title={`${guide.title} | ToolsRadar Guides`}
  description={guide.description}
  canonicalUrl={`https://lordorange.top/guides/${guide.slug}`}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb Nav -->
  <nav class="breadcrumb-nav">
    <a href="/">Radar</a>
    <span>/</span>
    <a href="/guides">Guides</a>
    <span>/</span>
    <span class="breadcrumb-current">{guide.title}</span>
  </nav>

  <article class="article-wrapper">
    <!-- Article Header -->
    <header class="article-header">
      <div class="article-meta-top">
        <span class="guide-category-pill">{guide.category}</span>
        <span class="guide-date-text">Published {guide.publishedAt} • Updated {guide.updatedAt}</span>
        <span class="guide-read-pill">⏱️ {guide.readTime}</span>
      </div>

      <h1 class="article-title">{guide.title}</h1>
      <p class="article-lead">{guide.tagline}</p>

      <!-- Author Card & Social Share -->
      <div class="author-share-bar">
        <div class="author-bio-card">
          <div class="author-avatar-large">{guide.author.avatar}</div>
          <div class="author-details">
            <span class="author-name-bold">{guide.author.name}</span>
            <span class="author-role-sub">{guide.author.role} • ToolsRadar Editorial</span>
          </div>
        </div>

        <div class="share-actions">
          <button id="copy-article-link" class="share-btn" title="Copy article URL">
            <span>🔗 Share</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Layout Grid: Table of Contents + Article Body -->
    <div class="article-grid">
      <!-- Main Content Body -->
      <main class="article-body-col">
        <!-- Injected Structured Article HTML -->
        <div class="article-prose" set:html={guide.contentHtml} />

        <!-- Article Tags -->
        <div class="article-tags-row">
          <span class="tags-label">Topics:</span>
          {guide.tags.map((tag) => (
            <span class="tag-pill">#{tag}</span>
          ))}
        </div>

        <!-- Editorial Review Box -->
        <div class="editorial-review-box">
          <div class="editorial-box-header">
            <span>🛡️ ToolsRadar Independent Review Guarantee</span>
          </div>
          <p>
            This technical guide was created following our 5-pillar editorial framework. We do not accept monetary compensation or sponsored product placements. All benchmarking tools are tested against real-world criteria.
          </p>
          <div class="editorial-box-links">
            <a href="/methodology">Our Methodology →</a>
            <a href="/about">About ToolsRadar →</a>
            <a href="/contact">Report Inaccuracy →</a>
          </div>
        </div>
      </main>

      <!-- Sticky Sidebar: Table of Contents -->
      <aside class="article-sidebar-col">
        <div class="sidebar-sticky-box">
          <h3 class="toc-title">Table of Contents</h3>
          <ul class="toc-list">
            {guide.tableOfContents.map((item) => (
              <li>
                <a href={`#${item.id}`} class="toc-link">
                  {item.title}
                </a>
              </li>
            ))}
          </ul>

          <div class="sidebar-cta-box">
            <h4>Explore the Tool Radar</h4>
            <p>Discover 450+ vetted developer tools updated daily.</p>
            <a href="/" class="btn btn-primary" style="width: 100%; justify-content: center; font-size: 0.85rem;">
              ⚡ Open Live Radar
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- Related Guides Section -->
    <section class="related-guides-section">
      <h2 class="related-title">Continue Reading</h2>
      <div class="related-grid">
        {relatedGuides.map((rel) => (
          <a href={`/guides/${rel.slug}`} class="related-card">
            <span class="related-cat">{rel.category}</span>
            <h3 class="related-heading">{rel.title}</h3>
            <span class="related-read">⏱️ {rel.readTime}</span>
          </a>
        ))}
      </div>
    </section>
  </article>

  <script>
    const copyBtn = document.getElementById('copy-article-link');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalText = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span>✓ Copied!</span>';
          setTimeout(() => {
            copyBtn.innerHTML = originalText;
          }, 2000);
        } catch (_) {
          // fallback
        }
      });
    }
  </script>
</Layout>

<style>
  /* Breadcrumbs */
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 1rem 0 2rem;
    flex-wrap: wrap;
  }

  .breadcrumb-nav a {
    color: var(--text-secondary);
  }

  .breadcrumb-nav a:hover {
    color: var(--accent);
  }

  .breadcrumb-current {
    color: var(--text-primary);
    max-width: 450px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .article-wrapper {
    max-width: 1100px;
    margin: 0 auto 5rem;
  }

  .article-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 2.25rem;
    margin-bottom: 2.5rem;
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .guide-category-pill {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .guide-date-text {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .guide-read-pill {
    font-size: 0.82rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .article-title {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: 2rem;
    }
  }

  .article-lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .author-share-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .author-bio-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar-large {
    width: 40px;
    height: 40px;
    line-height: 40px;
    text-align: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #38bdf8, #818cf8);
    color: #06080d;
    font-size: 0.85rem;
    font-weight: 800;
    font-family: var(--font-mono);
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name-bold {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .author-role-sub {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .share-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 0.45rem 0.85rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .share-btn:hover {
    background: rgba(56, 189, 248, 0.15);
    border-color: rgba(56, 189, 248, 0.35);
    color: #ffffff;
  }

  /* Article Grid */
  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .article-grid {
      grid-template-columns: 1fr 280px;
    }
  }

  /* Main Column Prose */
  .article-prose {
    line-height: 1.85;
    font-size: 1.05rem;
    color: #d4d4d8;
  }

  .article-prose :global(h2) {
    font-size: 1.7rem;
    font-weight: 800;
    color: #f4f4f5;
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.02em;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .article-prose :global(h3) {
    font-size: 1.3rem;
    font-weight: 700;
    color: #e4e4e7;
    margin: 1.75rem 0 0.75rem;
    letter-spacing: -0.015em;
  }

  .article-prose :global(h4) {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }

  .article-prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-prose :global(li) {
    line-height: 1.7;
  }

  .article-prose :global(strong) {
    color: #ffffff;
  }

  .article-prose :global(.callout-card) {
    background: rgba(18, 18, 24, 0.85);
    border-left: 3px solid #38bdf8;
    border-radius: 0 12px 12px 0;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }

  .article-prose :global(.callout-card p) {
    margin: 0;
    font-size: 0.96rem;
    color: #a1a1aa;
    line-height: 1.65;
  }

  .article-prose :global(pre) {
    background: #0d0e15;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    padding: 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 1.5rem 0;
  }

  .article-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: #7dd3fc;
    background: rgba(56, 189, 248, 0.08);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
  }

  .article-prose :global(pre code) {
    color: #e4e4e7;
    background: transparent;
    padding: 0;
  }

  .article-prose :global(.table-responsive) {
    overflow-x: auto;
    margin: 1.5rem 0 2rem;
  }

  .article-prose :global(.comparison-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    text-align: left;
  }

  .article-prose :global(.comparison-table th) {
    background: #14141a;
    color: #f4f4f5;
    font-weight: 700;
    padding: 0.85rem 1rem;
    border-bottom: 2px solid rgba(255, 255, 255, 0.12);
  }

  .article-prose :global(.comparison-table td) {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: #a1a1aa;
  }

  .article-prose :global(.comparison-table tr:hover td) {
    background: rgba(255, 255, 255, 0.02);
  }

  /* Tags Row */
  .article-tags-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 2.5rem 0 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tags-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .tag-pill {
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  /* Editorial Box */
  .editorial-review-box {
    background: rgba(18, 18, 24, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 1.5rem;
    margin-top: 2rem;
  }

  .editorial-box-header {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .editorial-review-box p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }

  .editorial-box-links {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Sidebar */
  .sidebar-sticky-box {
    position: sticky;
    top: 85px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .toc-title {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .toc-link {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.45;
    display: block;
    transition: color 0.15s ease;
  }

  .toc-link:hover {
    color: #38bdf8;
  }

  .sidebar-cta-box {
    background: linear-gradient(180deg, rgba(56, 189, 248, 0.08) 0%, rgba(18, 18, 23, 0.9) 100%);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 14px;
    padding: 1.25rem;
    text-align: center;
  }

  .sidebar-cta-box h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .sidebar-cta-box p {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  /* Related Guides */
  .related-guides-section {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .related-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .related-card {
    background: rgba(18, 18, 23, 0.75);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.35);
  }

  .related-cat {
    font-size: 0.72rem;
    color: #38bdf8;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .related-heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
    margin-bottom: 0.85rem;
  }

  .related-read {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
</style>
