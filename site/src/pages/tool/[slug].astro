      border-color: rgba(56, 189, 248, 0.25);
    }
  </style>

  <!-- Interactive Upvote, Bookmark & Share Script -->
  <script is:inline define:vars={{ toolId: tool.id, toolName: tool.name, toolUrl: tool.url }}>
    // Upvote
    const upvoteBtn = document.getElementById('upvote-btn');
    const upvoteCount = document.getElementById('upvote-count');
    const upvoteKey = `upvoted_${toolId}`;
    const baseScore = parseInt(upvoteCount?.innerText.replace('+', '') || '1', 10);

    if (localStorage.getItem(upvoteKey) === 'true') {
      upvoteBtn?.classList.add('active');
      if (upvoteCount) upvoteCount.innerText = `+${baseScore + 1}`;
    }

    upvoteBtn?.addEventListener('click', () => {
      const isUpvoted = upvoteBtn.classList.toggle('active');
      localStorage.setItem(upvoteKey, isUpvoted ? 'true' : 'false');
      if (upvoteCount) {
        upvoteCount.innerText = isUpvoted ? `+${baseScore + 1}` : `+${baseScore}`;
      }
    });

    // Bookmark
    const bookmarkBtn = document.getElementById('bookmark-btn');
    const bookmarkKey = `bookmarked_${toolId}`;
    if (localStorage.getItem(bookmarkKey) === 'true') {
      bookmarkBtn?.classList.add('bookmarked');
      const text = document.getElementById('bookmark-text');
      if (text) text.innerText = 'Saved';
    }

    bookmarkBtn?.addEventListener('click', () => {
      const isBookmarked = bookmarkBtn.classList.toggle('bookmarked');
      localStorage.setItem(bookmarkKey, isBookmarked ? 'true' : 'false');
      const text = document.getElementById('bookmark-text');
      if (text) text.innerText = isBookmarked ? 'Saved' : 'Save';
    });

    // Share
    const shareBtn = document.getElementById('share-btn');
    shareBtn?.addEventListener('click', async () => {
      const shareData = {
        title: `${toolName} - ToolsRadar`,
        text: `Check out ${toolName} on ToolsRadar:`,
        url: window.location.href,
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
          return;
        } catch (_) {}
      }

      // Fallback: clipboard copy
      try {
        await navigator.clipboard.writeText(window.location.href);
        const originalHtml = shareBtn.innerHTML;
        shareBtn.innerHTML = '<span>✅ Copied!</span>';
        setTimeout(() => {
          shareBtn.innerHTML = originalHtml;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy link:', err);
      }
    });

    // Copy Quickstart Command
    const copyCmdBtn = document.getElementById('copy-cmd-btn');
    const quickstartCode = document.getElementById('quickstart-code');
    if (copyCmdBtn && quickstartCode) {
      copyCmdBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(quickstartCode.innerText || '');
          const originalText = copyCmdBtn.innerText;
          copyCmdBtn.innerText = '✅ Copied!';
          setTimeout(() => {
            copyCmdBtn.innerText = originalText;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy quickstart:', err);
        }
      });
    }
  </script>
</Layout>
