---
import Layout from '../../layouts/Layout.astro';
import allTools from '../../../../data/all_tools.json';
import categories from '../../../../data/categories.json';
import { getToolIcon } from '../../utils/favicon';

export function getStaticPaths() {
  return allTools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;

const categoryInfo = categories.find(c => c.id === tool.category) || {
  id: tool.category,
  name: tool.category,
  description: ""
};

const alternatives = allTools
  .filter(t => t.category === tool.category && t.id !== tool.id)
  .slice(0, 4);

const iconUrl = getToolIcon(tool.url, tool.github_url);
const initial = tool.name.charAt(0);

const altClean = tool.primary_alternative?.trim() || '';
const altSlug = altClean ? altClean.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : '';
const comparisonPairSlug = (altSlug && altSlug !== tool.id) ? `${tool.id}-vs-${altSlug}` : null;

const pageTitle = tool.primary_alternative 
  ? (tool.pricing_model === 'Open Source'
      ? `${tool.name} - Free Open-Source Alternative to ${tool.primary_alternative}`
      : `${tool.name} - Free Alternative to ${tool.primary_alternative}`)
  : `${tool.name} - Review, Pricing & Key Features`;

// Quickstart command: prioritize authentic install command, fallback only for valid root git repos
let quickstartCommand = tool.install_command || '';
let quickstartLabel = (tool.id === 'fastrelease') ? 'Post-Purchase Repository Setup' : (tool.install_command ? 'Quick Installation / Run' : 'Quick Start Command');

if (!quickstartCommand) {
  const isSubfolder = tool.github_url && tool.github_url.includes('/tree/');
  const isActualRepo = tool.github_url && !isSubfolder && (tool.is_self_hostable || tool.pricing_model === 'Open Source');

  if (isActualRepo) {
    const cleanGithub = tool.github_url.replace(/^https?:\/\/(www\.)?github\.com\//, '').replace(/\/$/, '');
    const parts = cleanGithub.split('/');
    const repoPath = `${parts[0]}/${parts[1]}`;
    const repoName = parts[1] || tool.id;

    if (tool.is_self_hostable) {
      quickstartCommand = `git clone https://github.com/${repoPath}.git\ncd ${repoName}\ndocker compose up -d`;
      quickstartLabel = 'Docker / Compose Self-Host';
    } else {
      quickstartCommand = `git clone https://github.com/${repoPath}.git\ncd ${repoName}\nnpm install && npm run dev`;
      quickstartLabel = 'Local Git Setup';
    }
  } else if (isSubfolder) {
    quickstartCommand = `# Open web application directly in browser:\nopen "${tool.url}"\n\n# Or inspect public prototype files:\n# ${tool.github_url}`;
    quickstartLabel = 'Direct Web Access';
  } else {
    quickstartCommand = `# Open web application directly in browser:\nopen "${tool.url}"`;
    quickstartLabel = 'Direct Web Access';
  }
}

// Robust array unwrapping helper
const flattenList = (val: any): any[] => {
  if (!Array.isArray(val)) return [];
  const res: any[] = [];
  for (const item of val) {
    if (Array.isArray(item)) {
      res.push(...flattenList(item));
    } else if (item !== null && item !== undefined) {
      res.push(item);
    }
  }
  return res;
};

// Tailored Pros & Cons: Use tailored AI-extracted insights when available, with fallback
const rawPros = flattenList(tool.pros).filter(Boolean).map(String);
const displayPros = (rawPros.length > 0) ? rawPros : [
  tool.pricing_model === 'Open Source' 
    ? '100% Free & Open Source with full code auditability and no recurring fees' 
    : 'Generous free access tier with zero upfront credit card requirement',
  tool.is_self_hostable 
    ? 'Full data privacy and sovereignty — run securely in private Docker / local cloud' 
    : 'Zero-configuration cloud setup with immediate browser-based access',
  tool.primary_alternative 
    ? `Eliminates costly licensing and vendor lock-in compared to ${tool.primary_alternative}` 
    : 'Streamlined, lightweight interface designed for developer focus',
  tool.no_signup_required 
    ? 'Frictionless trial — test features immediately without email sign-up' 
    : 'Native team collaboration and multi-user permissions'
];

const rawCons = flattenList(tool.cons).filter(Boolean).map(String);
const displayCons = (rawCons.length > 0) ? rawCons : [
  tool.is_self_hostable 
    ? 'Self-hosting requires basic server management and backup routines' 
    : 'Hosted service depends on third-party cloud availability and terms',
  tool.primary_alternative 
    ? `Ecosystem plugins may be newer than entrenched giants like ${tool.primary_alternative}` 
    : 'Relatively fresh project — documentation is expanding rapidly',
  'Fast development velocity — recommend following release notes for major updates'
];

// Core Architecture & Key Capabilities normalization
const rawFeatures = flattenList(tool.key_features).filter(Boolean);
const displayFeatures: Array<{ title: string; description: string }> = rawFeatures.map((feat: any) => {
  if (typeof feat === 'string') {
    return {
      title: feat,
      description: `${tool.name} delivers built-in capabilities designed for production reliability.`
    };
  }
  if (typeof feat === 'object' && feat !== null) {
    return {
      title: feat.title || feat.name || '',
      description: feat.description || feat.desc || feat.summary || ''
    };
  }
  return null;
}).filter((feat): feat is { title: string; description: string } => Boolean(feat && feat.title));

if (displayFeatures.length === 0) {
  displayFeatures.push(
    {
      title: tool.pricing_model === 'Open Source' ? 'Open Architecture & Transparent Core' : 'Developer-First Modular Architecture',
      description: `${tool.name} is architected for clean integration and low maintenance overhead, prioritizing fast local execution.`
    },
    {
      title: tool.is_self_hostable ? 'Self-Contained Local Execution' : 'Streamlined Cloud Interoperability',
      description: tool.is_self_hostable
        ? 'Operate with total data sovereignty and privacy without depending on external telemetry or third-party servers.'
        : 'Access instant capabilities with zero complex infrastructure setup or machine dependencies.'
    },
    {
      title: tool.primary_alternative ? `Zero-Lock-in Alternative to ${tool.primary_alternative}` : 'Modern Automated Workflows',
      description: tool.primary_alternative
        ? `Delivers the core power and flexibility of ${tool.primary_alternative} with cleaner ergonomics and zero licensing penalties.`
        : 'Designed specifically to eliminate friction and automate repetitive engineering patterns.'
    }
  );
}

// Practical Applications & High-Value Use Cases normalization
const rawUseCases = flattenList(tool.use_cases).filter(Boolean).map(String);
const displayUseCases = rawUseCases.length > 0 ? rawUseCases : [
  `Integrating ${tool.name} into automated developer pipelines to reduce repetitive manual overhead`,
  `Deploying as a lightweight, privacy-conscious utility for team-wide productivity and local operations`,
  `Evaluating as an independent alternative to reduce vendor lock-in and monthly recurring software costs`
];

let domainName = '';
let displayUrlBar = '';
try {
  const parsed = new URL(tool.url);
  domainName = parsed.hostname;
  displayUrlBar = parsed.hostname + (parsed.pathname && parsed.pathname !== '/' ? parsed.pathname : '');
} catch (_) {
  domainName = tool.name.toLowerCase().replace(/[^a-z0-9]/g, '') + '.com';
  displayUrlBar = tool.url.replace(/^https?:\/\//, '');
}

// 4-Dimension Hands-on Scorecard (0 - 10)
const setupScore = tool.no_signup_required 
  ? 9.5 
  : (tool.install_command ? 8.8 : (tool.is_self_hostable ? 8.2 : 8.5));

const auditScore = tool.pricing_model === 'Open Source' 
  ? 9.8 
  : (tool.github_url ? 9.0 : 7.6);

const vitalityScore = Math.min(9.8, Math.max(7.2, Number((7.0 + ((tool.signal_score || 50) / 100) * 2.5).toFixed(1))));

const valueScore = tool.pricing_model === 'Open Source' 
  ? 10.0 
  : (tool.pricing_model === 'Free' ? 9.2 : 8.4);

const overallScore = Number(((setupScore + auditScore + vitalityScore + valueScore) / 4).toFixed(1));

const altPhrase = tool.primary_alternative 
  ? `Discover this ${tool.pricing_model === 'Open Source' ? 'open-source ' : ''}alternative to ${tool.primary_alternative}.` 
  : '';

const priceValue = (tool.pricing_model === 'Paid' || tool.pricing_model === 'Usage-based')
  ? (tool.starting_price || (tool.id === 'fastrelease' ? '199' : '1'))
  : '0';

// Structured FAQ dataset tailored for this tool (satisfies Google FAQPage Schema & kills thin content)
const defaultFaqList = [
  {
    q: `Is ${tool.name} completely free or does it require a paid subscription?`,
    a: tool.pricing_model === 'Open Source'
      ? `${tool.name} is 100% free and open-source under an open software license. There are no mandatory monthly subscription fees to access the source code or run it locally.`
      : (tool.pricing_model === 'Free'
          ? `${tool.name} is available completely free of charge. Developers can access its core features without payment.`
          : (tool.pricing_model === 'Paid'
              ? `${tool.name} is a commercial developer product with transparent project-based or usage-based pricing designed for professional teams.`
              : `${tool.name} provides an accessible free tier or trial alongside paid upgrades for high-volume production use.`))
  },
  {
    q: `How does ${tool.name} compare to alternative solutions?`,
    a: tool.comparison_vs_alt || `Compared to alternative solutions, ${tool.name} offers distinct developer flexibility, streamlined workflows, and focused features.`
  },
  {
    q: `Can I self-host ${tool.name} on private servers or Docker?`,
    a: tool.is_self_hostable
      ? `Yes. ${tool.name} is designed for self-hosting via Docker or direct server deployment. Running on your own infrastructure allows you to maintain direct control over your local compute, database storage, and operational environment.`
      : `${tool.name} is delivered primarily as a cloud-hosted web application or managed API endpoint, providing turnkey infrastructure without requiring dedicated server management.`
  },
  {
    q: `Do I need to create an account or provide a credit card to try ${tool.name}?`,
    a: tool.pricing_model === 'Paid'
      ? `${tool.name} is a commercial developer product acquired directly under official license terms. No free trial account or public evaluation tier is provided.`
      : (tool.no_signup_required
          ? `No account creation or credit card is required to evaluate ${tool.name}. You can immediately access core features or run it locally without onboarding friction.`
          : `An account registration is standard to provision access credentials, manage configurations, and coordinate team access.`)
  },
  {
    q: `What is the recommended quickstart workflow for ${tool.name}?`,
    a: quickstartCommand
      ? `You can launch or test ${tool.name} quickly using the following command:\n\n${quickstartCommand}\n\nVisit the official portal at ${tool.url} for documentation and guides.`
      : `Navigate to the official portal at ${tool.url} to review documentation, guides, and setup requirements.`
  }
];

const faqList = (tool.faqs && Array.isArray(tool.faqs) && tool.faqs.length > 0)
  ? tool.faqs
  : defaultFaqList;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": tool.name,
      "description": tool.summary,
      "applicationCategory": categoryInfo.name,
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": priceValue,
        "priceCurrency": "USD"
      },
      "url": tool.url
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqList.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={`${tool.name}: ${tool.tagline}. ${altPhrase} Read in-depth overview, pricing model, key features, and compare alternatives on ToolsRadar.`}
  canonicalUrl={`https://lordorange.top/tool/${tool.id}`}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb-nav">
    <a href="/">Radar</a>
    <span>/</span>
    <a href={`/category/${tool.category}`}>{categoryInfo.name}</a>
    <span>/</span>
    <span class="breadcrumb-current">{tool.name}</span>
  </nav>

  <!-- Hero Header Card -->
  <article class="hero-detail-card">
    <div class="hero-glow-border"></div>

    <div class="hero-detail-content">
      <!-- Title & Icon Row -->
      <div class="hero-header-row">
        <div class="hero-tool-icon">
          {iconUrl ? (
            <img 
              src={iconUrl} 
              alt={`${tool.name} logo`} 
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="hero-icon-fallback" style="display: none;">
              {initial}
            </div>
          ) : (
            <div class="hero-icon-fallback">
              {initial}
            </div>
          )}
        </div>

        <div class="hero-meta-col">
          <div class="hero-title-line">
            <h1 class="hero-tool-name">{tool.name}</h1>
            <span class={tool.pricing_model === "Open Source" ? "badge badge-oss" : "badge badge-free"}>
              {tool.pricing_model}
            </span>

            {tool.primary_alternative && (
              <span class="alt-hero-badge">
                🔄 Alt to {tool.primary_alternative}
              </span>
            )}
          </div>

          <p class="hero-tool-tagline">
            {tool.tagline}
          </p>

          <!-- Feature badges row -->
          <div class="hero-badges-row">
            {tool.is_self_hostable && (
              <span class="badge-feature self-host">🐳 Self-Hostable</span>
            )}
            {tool.no_signup_required && (
              <span class="badge-feature no-signup">🔓 No Sign-up</span>
            )}
            {tool.signal_score && (
              <span class="badge-feature traction">⚡ Editorial Signal: {tool.signal_score}/100</span>
            )}
            {tool.stars > 0 && (
              <span class="stars-badge">
                <span>★</span>
                <span>{tool.stars.toLocaleString()} Stars</span>
              </span>
            )}
          </div>
        </div>
      </div>

      <!-- Action Buttons & Interactive Social Row -->
      <div class="hero-actions-row">
        <div class="primary-links-group">
          <a 
            href={tool.url} 
            target="_blank" 
            rel="noopener noreferrer nofollow" 
            class="btn btn-primary"
          >
            <span>Visit Official Website</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>

          {tool.github_url && (
            <a 
              href={tool.github_url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-secondary"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
              </svg>
              <span>GitHub</span>
            </a>
          )}
        </div>

        <!-- Interactive Engagement: Upvote, Bookmark, Share -->
        <div class="interactive-social-group">
          <button id="upvote-btn" class="social-btn" title="Upvote this tool">
            <span class="social-icon">▲</span>
            <span id="upvote-text">Upvote</span>
            <span id="upvote-count" class="social-badge">+{tool.signal_score || 1}</span>
          </button>

          <button id="bookmark-btn" class="social-btn" title="Bookmark for later">
            <span id="bookmark-icon">★</span>
            <span id="bookmark-text">Save</span>
          </button>

          <button id="share-btn" class="social-btn" title="Share tool link">
            <span>🔗</span>
            <span>Share</span>
          </button>
        </div>
      </div>
    </div>
  </article>

  <!-- Analyst Verdict & Strategic Take Banner -->
  {tool.verdict && (
    <section class="verdict-banner-card">
      <div class="verdict-header">
        <div class="verdict-pill">
          <span class="verdict-icon">💡</span>
          <span class="verdict-label">Analyst Verdict & Strategic Take</span>
        </div>
        <span class="verdict-badge">AI Editorial Assessment</span>
      </div>
      <blockquote class="verdict-quote">
        "{tool.verdict}"
      </blockquote>
    </section>
  )}

  <!-- Hands-on Scorecard & Benchmark Assessment -->
  <section class="section-card scorecard-card">
    <div class="scorecard-header-row">
      <div class="scorecard-title-group">
        <div class="scorecard-pill">
          <span>📋 Editorial Architecture Analysis</span>
        </div>
        <h2 class="scorecard-heading">ToolsRadar Evaluation Scorecard</h2>
      </div>
      <div class="scorecard-overall-badge">
        <span class="overall-label">Editorial Benchmark</span>
        <span class="overall-score">{overallScore} <span class="score-max">/ 10</span></span>
        <span class="overall-status">Internal Editorial Score</span>
      </div>
    </div>

    <div class="scorecard-metrics-grid">
      <div class="metric-item">
        <div class="metric-top">
          <span class="metric-name">🚀 Setup & Onboarding</span>
          <span class="metric-value">{setupScore} / 10</span>
        </div>
        <div class="metric-progress-bg">
          <div class="metric-progress-bar bar-setup" style={`width: ${setupScore * 10}%;`}></div>
        </div>
        <span class="metric-subtext">
          {tool.no_signup_required ? "Frictionless instant test with zero registration requirement." : (tool.install_command ? "Direct installation command available out of the box." : "Standard setup flow.")}
        </span>
      </div>

      <div class="metric-item">
        <div class="metric-top">
          <span class="metric-name">🛡️ Code & Auditability</span>
          <span class="metric-value">{auditScore} / 10</span>
        </div>
        <div class="metric-progress-bg">
          <div class="metric-progress-bar bar-audit" style={`width: ${auditScore * 10}%;`}></div>
        </div>
        <span class="metric-subtext">
          {tool.pricing_model === 'Open Source' ? "100% open-source repository with public commit history." : "Closed core or proprietary hosted backend."}
        </span>
      </div>

      <div class="metric-item">
        <div class="metric-top">
          <span class="metric-name">👥 Maintenance & Vitality</span>
          <span class="metric-value">{vitalityScore} / 10</span>
        </div>
        <div class="metric-progress-bg">
          <div class="metric-progress-bar bar-vitality" style={`width: ${vitalityScore * 10}%;`}></div>
        </div>
        <span class="metric-subtext">
          {tool.pricing_model === 'Open Source' ? (tool.signal_score >= 80 ? "High open-source community velocity and active releases." : "Steady release pace and active maintenance.") : "Active project maintenance and verified public documentation."}
        </span>
      </div>

      <div class="metric-item">
        <div class="metric-top">
          <span class="metric-name">💰 Cost / Value Advantage</span>
          <span class="metric-value">{valueScore} / 10</span>
        </div>
        <div class="metric-progress-bg">
          <div class="metric-progress-bar bar-value" style={`width: ${valueScore * 10}%;`}></div>
        </div>
        <span class="metric-subtext">
          {tool.pricing_model === 'Open Source' ? "Zero licensing fees with unlimited self-hosting capabilities." : (tool.pricing_model === 'Paid' ? "Commercial software licensing terms for project-based deployments." : (tool.pricing_model === 'Usage-based' ? "Usage-based consumption billing based on actual API/job volume." : "Accessible free usage tier without mandatory subscription."))}
        </span>
      </div>
    </div>

    <div class="scorecard-footer-bar">
      <div class="scorecard-audience-pill">
        <span class="audience-label">Best Suited For:</span>
        <span class="audience-text">{tool.target_audience || `${categoryInfo.name} engineers and teams seeking modern developer efficiency.`}</span>
      </div>
      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem;">
        <a href="/methodology" class="methodology-scorecard-link">
          Learn how we score tools →
        </a>
        <span style="font-size: 0.72rem; color: var(--text-muted); text-align: right;">
          *Internal editorial benchmark, not vendor-reported financial or buyer statistics
        </span>
      </div>
    </div>
  </section>

  <!-- Live Website Browser Mockup -->
  <section class="section-card browser-preview-card">
    <div class="browser-mockup-header">
      <div class="traffic-lights">
        <span class="light red"></span>
        <span class="light yellow"></span>
        <span class="light green"></span>
      </div>
      <div class="browser-address-bar">
        <span style="font-size: 0.72rem; color: #10b981;">🔒</span>
        <span class="browser-url-text">https://{displayUrlBar}</span>
      </div>
      <a 
        href={tool.url} 
        target="_blank" 
        rel="noopener noreferrer nofollow" 
        class="browser-visit-pill"
      >
        Open Site ↗
      </a>
    </div>

    <div class="browser-mockup-body">
      <div class="browser-preview-overlay">
        <div class="preview-badge">Live Web Application</div>
        <h3 class="preview-hero-title">{tool.name}</h3>
        <p class="preview-hero-tagline">{tool.tagline}</p>
        <div class="preview-cta-row">
          <a href={tool.url} target="_blank" rel="noopener noreferrer nofollow" class="btn btn-primary" style="padding: 0.65rem 1.4rem;">
            Launch App 🚀
          </a>
          {tool.github_url && (
            <a href={tool.github_url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              View Source Code ↗
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Start & Deployment Box -->
  <section class="section-card quickstart-card">
    <div class="quickstart-header">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="color: #38bdf8; font-size: 1.1rem;">⚡</span>
        <h2 style="font-size: 1.1rem; font-weight: 700; color: #f4f4f5; margin: 0;">
          {quickstartLabel}
        </h2>
      </div>
      <button id="copy-cmd-btn" class="copy-cmd-btn">
        📋 Copy Command
      </button>
    </div>

    <pre class="quickstart-pre"><code id="quickstart-code">{quickstartCommand}</code></pre>
  </section>

  <!-- Detailed Specs & Problem Overview -->
  <section class="details-grid-wrapper">
    <!-- What problem does it solve -->
    <div class="section-card">
      <h2 class="card-section-title">
        <span style="color: var(--accent);">💡</span> What Problem Does {tool.name} Solve?
      </h2>
      <p style="color: var(--text-secondary); font-size: 1.05rem; line-height: 1.75; margin-bottom: 1.5rem;">
        {tool.summary}
      </p>

      <!-- Specs Matrix -->
      <div class="specs-matrix">
        <div class="spec-item">
          <span class="spec-label">Category</span>
          <a href={`/category/${tool.category}`} class="spec-value accent-link">{categoryInfo.name}</a>
        </div>
        <div class="spec-item">
          <span class="spec-label">Commercial Alternative</span>
          <span class="spec-value" style="color: var(--accent);">{tool.primary_alternative || "Standalone Utility"}</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Self-Hostable</span>
          <span class="spec-value" style={tool.is_self_hostable ? "color: var(--emerald);" : "color: #a1a1aa;"}>
            {tool.is_self_hostable ? "Yes (Docker/Bare-metal)" : "Cloud SaaS"}
          </span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Sign-up Barrier</span>
