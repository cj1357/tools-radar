---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy - ToolsRadar",
  "description": "Comprehensive Privacy Policy, Cookie Disclosures, GDPR/CCPA Rights, and Advertising Transparency statement for ToolsRadar.",
  "url": "https://lordorange.top/privacy"
};
---

<Layout 
  title="Privacy Policy - ToolsRadar"
  description="Privacy policy, Google AdSense cookie disclaimers, GDPR, CCPA, and data transparency statement for ToolsRadar users and visitors."
  canonicalUrl="https://lordorange.top/privacy"
  jsonLd={jsonLd}
>
  <div class="legal-container">
    <header class="legal-header">
      <h1 class="legal-title">Privacy Policy</h1>
      <p class="legal-date">Last Updated: October 12, 2026</p>
      <p class="legal-lead">
        At <strong>ToolsRadar</strong> (accessible at <a href="https://lordorange.top">https://lordorange.top</a>), your privacy is of paramount importance to us. This Privacy Policy outlines what types of information we collect, how it is used, and how we safeguard your data in compliance with international data privacy regulations.
      </p>
    </header>

    <div class="legal-body">
      <!-- Section 1 -->
      <section class="legal-section">
        <h2>1. Information We Collect</h2>
        <p>
          ToolsRadar is an open software discovery directory and technical publication. We believe in minimal data footprint:
        </p>
        <ul>
          <li><strong>No Mandatory User Accounts:</strong> You can freely explore our tool directories, read guides, filter categories, and inspect benchmarks without creating an account or providing your name, phone number, or payment details.</li>
          <li><strong>Voluntary Submissions & Communication:</strong> If you contact us via email (<a href="mailto:hello@lordorange.top">hello@lordorange.top</a>) or submit software via our submission form, we collect the details you provide (such as your name, email address, and repository URL) solely to respond to your inquiry or review your tool.</li>
          <li><strong>Log Files & Technical Telemetry:</strong> Like almost all websites, our web hosting servers (e.g. Cloudflare) automatically log anonymous aggregate technical information. This includes browser user agent, IP address (anonymized), operating system, referral URLs, pages viewed, and timestamps. These logs are used purely for security mitigation (DDoS prevention), diagnosing server performance, and site reliability.</li>
        </ul>
      </section>

      <!-- Section 2 -->
      <section class="legal-section">
        <h2>2. Cookies and Web Beacons</h2>
        <p>
          ToolsRadar uses standard cookies and local browser storage to provide a functional and frictionless user experience:
        </p>
        <ul>
          <li><strong>Functional Storage:</strong> We use browser localStorage to preserve your interface preferences (such as bookmarked tools, dark theme state, or dismissed notices). No personally identifiable information is stored.</li>
          <li><strong>Analytics Cookies:</strong> We utilize Google Analytics 4 (GA4) with IP anonymization enabled to understand aggregate metrics such as popular tool categories, page navigation paths, and average reading time. You can prevent Google Analytics tracking at any time by installing the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.</li>
        </ul>
      </section>

      <!-- Section 3 - Google AdSense & Third-Party Advertising Compliance -->
      <section class="legal-section highlight-box">
        <h2>3. Google AdSense & Third-Party Advertising Notice</h2>
        <p>
          To support the hosting, infrastructure, and ongoing editorial curation of ToolsRadar, we work with third-party advertising partners, including <strong>Google AdSense</strong>.
        </p>
        <p>
          Please note the following mandated advertising disclosures:
        </p>
        <ul>
          <li><strong>Third-party vendor cookies:</strong> Third-party vendors, including Google, use cookies (such as the DoubleClick DART cookie) to serve advertisements based on a user's prior visits to ToolsRadar or other websites on the Internet.</li>
          <li><strong>Personalized Advertising:</strong> Google's use of advertising cookies enables it and its partners to serve ads to our users based on their visits to our site and/or other sites across the World Wide Web.</li>
          <li><strong>Opting Out of Personalized Ads:</strong> Users may opt out of personalized advertising by visiting <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>. Alternatively, you may opt out of a third-party vendor's use of cookies for personalized advertising by visiting the <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer">Digital Advertising Alliance Consumer Choice Tool (aboutads.info)</a> or the <a href="https://www.youronlinechoices.com/" target="_blank" rel="noopener noreferrer">Your Online Choices (EDAA)</a> portal.</li>
        </ul>
      </section>

      <!-- Section 4 -->
      <section class="legal-section">
        <h2>4. External Links to Third-Party Software</h2>
        <p>
          ToolsRadar features external links pointing to software homepages, GitHub repositories, documentation sites, and third-party SaaS services. We do not own, control, or operate these third-party platforms. Once you click an outbound link and leave ToolsRadar, our Privacy Policy no longer applies. We strongly encourage you to review the privacy policies and security posture of any external software repository or service you access.
        </p>
      </section>

      <!-- Section 5 - GDPR Compliance -->
      <section class="legal-section">
        <h2>5. European General Data Protection Regulation (GDPR) Rights</h2>
        <p>
          If you are an individual residing in the European Economic Area (EEA) or the United Kingdom (UK), you possess specific statutory rights regarding your personal data:
        </p>
        <ul>
          <li><strong>The Right to Access:</strong> You have the right to request copies of any personal data we hold about you.</li>
          <li><strong>The Right to Rectification:</strong> You have the right to request that we correct any information you believe is inaccurate or incomplete.</li>
          <li><strong>The Right to Erasure:</strong> You have the right to request the deletion of your personal data under certain statutory conditions.</li>
          <li><strong>The Right to Restrict Processing:</strong> You have the right to object to or request that we restrict the processing of your personal data.</li>
          <li><strong>The Right to Data Portability:</strong> You have the right to request that we transfer data that we have collected to another organization or directly to you.</li>
        </ul>
        <p>
          To exercise any of these rights, please email us directly at <a href="mailto:hello@lordorange.top">hello@lordorange.top</a>. We respond to all verified requests within thirty (30) days.
        </p>
      </section>

      <!-- Section 6 - California Privacy Rights (CCPA/CPRA) -->
      <section class="legal-section">
        <h2>6. California Consumer Privacy Act (CCPA / CPRA)</h2>
        <p>
          Under the California Consumer Privacy Act (CCPA) and California Privacy Rights Act (CPRA), California residents have specific privacy protections:
        </p>
        <ul>
          <li><strong>Right to Know:</strong> You may request disclosure of the categories and specific pieces of personal data collected about you.</li>
          <li><strong>Right to Delete:</strong> You may request deletion of personal information collected from you.</li>
          <li><strong>No Sale of Personal Information:</strong> ToolsRadar <strong>does not sell, rent, or trade</strong> your personal information to third parties for monetary consideration.</li>
          <li><strong>Non-Discrimination:</strong> We will never discriminate against you, alter service tiers, or degrade directory functionality for exercising your statutory privacy rights.</li>
        </ul>
      </section>

      <!-- Section 7 -->
      <section class="legal-section">
        <h2>7. Children's Online Privacy Protection (COPPA)</h2>
        <p>
          ToolsRadar is an engineering and developer tooling publication intended for professionals, students, and software practitioners. We do not knowingly collect or solicit personal identifiable information from children under the age of 13. If you believe that a child has provided us with personal information, please contact us immediately, and we will promptly remove such information from our records.
        </p>
      </section>

      <!-- Section 8 -->
      <section class="legal-section">
        <h2>8. Contact & Data Protection Officer</h2>
        <p>
          If you have any questions, concerns, or requests regarding this Privacy Policy or our data management practices, please contact our team:
        </p>
        <div class="contact-box">
          <p><strong>ToolsRadar Privacy Team</strong></p>
          <p>Email: <a href="mailto:hello@lordorange.top">hello@lordorange.top</a></p>
          <p>Website: <a href="https://lordorange.top">https://lordorange.top</a></p>
          <p>GitHub Repository: <a href="https://github.com/cj1357/tools-radar" target="_blank" rel="noopener noreferrer">https://github.com/cj1357/tools-radar</a></p>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .legal-container {
    max-width: 820px;
    margin: 2rem auto 5rem;
    padding: 0 0.5rem;
  }

  .legal-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.75rem;
    margin-bottom: 2.25rem;
  }

  .legal-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .legal-date {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
  }

  .legal-lead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .legal-body {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .legal-section h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
    letter-spacing: -0.015em;
  }

  .legal-section p {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 0.85rem;
  }

  .legal-section ul {
    list-style: disc;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.7;
    margin-bottom: 0.85rem;
  }

  .highlight-box {
    background: rgba(56, 189, 248, 0.05);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 14px;
    padding: 1.75rem;
  }

  .contact-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  .contact-box p {
    margin-bottom: 0.35rem;
  }

  .contact-box p:last-child {
    margin-bottom: 0;
  }
</style>
