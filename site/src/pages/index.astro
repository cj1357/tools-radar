---
import Layout from '../layouts/Layout.astro';
import allTools from '../../../data/all_tools.json';
import categories from '../../../data/categories.json';
import { getToolIcon } from '../utils/favicon';

const categoryCounts = categories.map(cat => ({
  ...cat,
  count: allTools.filter(t => t.category === cat.id).length
}));

const selfHostCount = allTools.filter(t => t.is_self_hostable).length;
const noSignupCount = allTools.filter(t => t.no_signup_required).length;
const altCount = allTools.filter(t => t.primary_alternative).length;
const highSignalCount = allTools.filter(t => (t.signal_score || 0) >= 80).length;
---

<Layout 
  title="ToolsRadar - Curated Daily Directory of New Developer Tools & AI Apps" 
  description="Discover the highest-signal new developer tools, open-source repositories, and AI apps launched today on GitHub Trending, Hacker News, and Product Hunt."
  canonicalUrl="https://tools.yourdomain.com/"
>
  <!-- Hero Section -->
  <section style="text-align: center; padding: 3rem 0 2rem;">
    <!-- Live Status Pill -->
    <div style="display: inline-block; margin-bottom: 1.25rem;">
      <div class="live-badge">
        <span class="live-dot"></span>
        <span>Live Radar • {allTools.length} Fresh Releases Indexed</span>
      </div>
    </div>

    <!-- Title -->
    <h1 style="font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.15; margin-bottom: 1rem;" class="gradient-title">
      Discover Tomorrow's Best <br />
      <span class="gradient-accent">Developer Tools & AI Gems</span>
    </h1>

    <p style="font-size: 1.1rem; color: var(--text-secondary); max-width: 650px; margin: 0 auto; line-height: 1.6;">
      High-signal software curation filtered for open-source alternatives, self-hostable tech, and developer utilities.
    </p>

    <!-- Raycast-style Instant Search Bar -->
    <div class="search-box-wrapper">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="tool-search" 
        class="search-input" 
        placeholder="Search by tool name, tag, or topic (e.g. AI, CLI, Docker, Rust)..." 
        autocomplete="off"
      />
      <div class="search-shortcut">/</div>
    </div>

    <!-- Hardcore Feature Filter Chips -->
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: 1.5rem;" id="feature-filters">
      <button 
        class="filter-chip active" 
        data-filter="all"
      >
        <span>⚡ All Tools</span>
        <span class="chip-count">{allTools.length}</span>
      </button>

      <button 
        class="filter-chip" 
        data-filter="alternatives"
      >
        <span>🔄 Big-Tech Alternatives</span>
        <span class="chip-count">{altCount}</span>
      </button>

      <button 
        class="filter-chip" 
        data-filter="self-host"
      >
        <span>🐳 Self-Hostable</span>
        <span class="chip-count">{selfHostCount}</span>
      </button>

      <button 
        class="filter-chip" 
        data-filter="no-signup"
      >
        <span>🔓 No Sign-up</span>
        <span class="chip-count">{noSignupCount}</span>
      </button>

      <button 
        class="filter-chip" 
        data-filter="high-signal"
      >
        <span>🔥 High Traction</span>
        <span class="chip-count">{highSignalCount}</span>
      </button>
    </div>

    <!-- Category Filter Pills -->
    <div style="display: flex; flex-wrap: wrap; gap: 0.45rem; justify-content: center; margin-top: 1.25rem;">
      {categoryCounts.map(cat => (
        <a 
          href={`/category/${cat.id}`} 
          style="display: inline-flex; align-items: center; gap: 0.35rem; background: rgba(24, 24, 27, 0.6); border: 1px solid var(--border-subtle); padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.8rem; color: var(--text-secondary); text-decoration: none; transition: all 0.15s ease;"
          onmouseover="this.style.borderColor='rgba(255,255,255,0.2)'; this.style.color='#f4f4f5';"
          onmouseout="this.style.borderColor='rgba(255,255,255,0.08)'; this.style.color='#a1a1aa';"
        >
          <span>{cat.name}</span>
          <span style="background: rgba(255, 255, 255, 0.06); color: var(--text-muted); font-size: 0.7rem; padding: 0.05rem 0.35rem; border-radius: 9999px;">{cat.count}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Feed Header -->
  <section style="margin-top: 2.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.85rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.02em;">
          Curated Feed
        </h2>
        <span id="results-count" style="font-size: 0.8rem; color: var(--text-muted); background: rgba(255, 255, 255, 0.05); padding: 0.15rem 0.5rem; border-radius: 4px;">
          Showing {allTools.length} tools
        </span>
      </div>

      <div style="font-size: 0.8rem; color: var(--text-muted);">
        Aggregated across GitHub, Product Hunt & Hacker News
      </div>
    </div>

    <!-- Empty search state -->
    <div id="no-results" style="display: none; text-align: center; padding: 4rem 1rem; color: var(--text-muted);">
      <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">No tools match your current filter.</p>
      <p style="font-size: 0.85rem;">Try resetting your search query or selecting "All Tools".</p>
    </div>

    <!-- Tools Grid -->
    <div class="tools-grid" id="tools-container">
      {allTools.map(tool => {
        const iconUrl = getToolIcon(tool.url, tool.github_url);
        const initial = tool.name.charAt(0);
        const searchCorpus = `${tool.name} ${tool.tagline} ${tool.category} ${(tool.tags || []).join(" ")} ${tool.primary_alternative || ""}`.toLowerCase();

        return (
          <article 
            class="tool-card" 
            data-corpus={searchCorpus}
            data-self-host={tool.is_self_hostable ? "true" : "false"}
            data-no-signup={tool.no_signup_required ? "true" : "false"}
            data-has-alt={tool.primary_alternative ? "true" : "false"}
            data-signal={tool.signal_score || 0}
          >
            <div>
              <div class="tool-card-top">
                <div class="tool-icon">
                  {iconUrl ? (
                    <img 
                      src={iconUrl} 
                      alt={`${tool.name} icon`} 
                      loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="tool-icon-fallback" style="display: none;">
                      {initial}
                    </div>
                  ) : (
                    <div class="tool-icon-fallback">
                      {initial}
                    </div>
                  )}
                </div>

                <div class="tool-meta-header">
                  <div class="tool-title-row">
                    <h3 class="tool-title">
                      <a href={`/tool/${tool.id}`} style="color: var(--text-primary); text-decoration: none;">
                        {tool.name}
                      </a>
                    </h3>

                    <div style="display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0;">
                      {tool.stars > 0 && (
                        <span class="stars-badge">
                          <span>★</span>
                          <span>{tool.stars > 999 ? `${(tool.stars / 1000).toFixed(1)}k` : tool.stars}</span>
                        </span>
                      )}
                      {tool.signal_score && (
                        <span style="font-size: 0.7rem; font-weight: 700; color: #a1a1aa; background: rgba(255, 255, 255, 0.06); padding: 0.15rem 0.4rem; border-radius: 4px; font-family: var(--font-mono);">
                          ⚡{tool.signal_score}
                        </span>
                      )}
                    </div>
                  </div>

                  <p class="tool-tagline">{tool.tagline}</p>
                </div>
              </div>

              <!-- Alternatives Pill & Hardcore Badges -->
              <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.85rem;">
                {tool.primary_alternative && (
                  <span style="display: inline-flex; align-items: center; gap: 0.25rem; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); color: #38bdf8; font-size: 0.72rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 4px;">
                    🔄 Alt to {tool.primary_alternative}
                  </span>
                )}

                {tool.is_self_hostable && (
                  <span style="display: inline-flex; align-items: center; gap: 0.2rem; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2); color: #6ee7b7; font-size: 0.7rem; padding: 0.15rem 0.45rem; border-radius: 4px;">
                    🐳 Self-Hostable
                  </span>
                )}

                {tool.no_signup_required && (
                  <span style="display: inline-flex; align-items: center; gap: 0.2rem; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.2); color: #fcd34d; font-size: 0.7rem; padding: 0.15rem 0.45rem; border-radius: 4px;">
                    🔓 No Sign-up
                  </span>
                )}

                {tool.tags && tool.tags.slice(0, 3).map((tag: string) => (
                  <span style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.07); color: #a1a1aa; font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 4px;">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Footer -->
            <div class="tool-footer">
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span class={tool.pricing_model === "Open Source" ? "badge badge-oss" : "badge badge-free"}>
                  {tool.pricing_model}
                </span>

                <span class="badge badge-source">
                  {tool.source === "github_trending" ? "GitHub" : tool.source === "producthunt" ? "PH" : "HN"}
                </span>
              </div>

              <a href={`/tool/${tool.id}`} style="display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 600; font-size: 0.82rem; color: var(--accent);">
                Details & Alternatives <span style="font-size: 1rem; line-height: 1;">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Filter & Chip Styles -->
  <style>
    .filter-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: rgba(24, 24, 27, 0.8);
      border: 1px solid var(--border-subtle);
      padding: 0.4rem 0.9rem;
      border-radius: 9999px;
      font-size: 0.82rem;
      color: var(--text-secondary);
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s ease;
      font-family: inherit;
    }

    .filter-chip:hover {
      border-color: rgba(255, 255, 255, 0.2);
      color: var(--text-primary);
    }

    .filter-chip.active {
      background: #27272a;
      border-color: var(--accent);
      color: #ffffff;
      font-weight: 600;
      box-shadow: 0 0 14px rgba(56, 189, 248, 0.2);
    }

    .chip-count {
      background: rgba(255, 255, 255, 0.1);
      color: #a1a1aa;
      font-size: 0.72rem;
      padding: 0.1rem 0.45rem;
      border-radius: 9999px;
    }

    .filter-chip.active .chip-count {
      background: rgba(56, 189, 248, 0.2);
      color: var(--accent);
    }
  </style>

  <!-- Interactive Search and Chip Filtering Script -->
  <script is:inline>
    const searchInput = document.getElementById('tool-search');
    const filterChips = document.querySelectorAll('.filter-chip');
    const cards = document.querySelectorAll('.tool-card');
    const noResults = document.getElementById('no-results');
    const resultsCount = document.getElementById('results-count');
    const totalTools = cards.length;

    let currentFilter = 'all';

    // Keyboard shortcut '/'
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput.focus();
      }
    });

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let matchCount = 0;

      cards.forEach(card => {
        const corpus = card.getAttribute('data-corpus') || '';
        const isSelfHost = card.getAttribute('data-self-host') === 'true';
        const isNoSignup = card.getAttribute('data-no-signup') === 'true';
        const hasAlt = card.getAttribute('data-has-alt') === 'true';
        const signal = parseInt(card.getAttribute('data-signal') || '0', 10);

        // Filter condition
        let passesChip = true;
        if (currentFilter === 'self-host') passesChip = isSelfHost;
        else if (currentFilter === 'no-signup') passesChip = isNoSignup;
        else if (currentFilter === 'alternatives') passesChip = hasAlt;
        else if (currentFilter === 'high-signal') passesChip = signal >= 80;

        // Search condition
        const passesQuery = !query || corpus.includes(query);

        if (passesChip && passesQuery) {
          card.style.display = 'flex';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (resultsCount) {
        resultsCount.textContent = `Showing ${matchCount} of ${totalTools} tools`;
      }

      if (noResults) {
        noResults.style.display = matchCount === 0 ? 'block' : 'none';
      }
    }

    searchInput?.addEventListener('input', applyFilters);

    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        filterChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        currentFilter = chip.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });
  </script>
</Layout>
