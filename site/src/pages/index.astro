---
import Layout from '../layouts/Layout.astro';
import RadarScope from '../components/RadarScope.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import BattlegroundSection from '../components/BattlegroundSection.astro';
import FeaturedGuides from '../components/FeaturedGuides.astro';
import allTools from '../../../data/all_tools.json';
import categories from '../../../data/categories.json';
import { getToolIcon } from '../utils/favicon';

// Compute category counts
const categoryCounts = categories.map(cat => ({
  ...cat,
  count: allTools.filter(t => t.category === cat.id).length
}));

// Quick metrics
const selfHostCount = allTools.filter(t => t.is_self_hostable).length;
const noSignupCount = allTools.filter(t => t.no_signup_required).length;
const altCount = allTools.filter(t => t.primary_alternative).length;
const highSignalCount = allTools.filter(t => (t.signal_score || 0) >= 80).length;

// Choose breakout spotlight tool
const spotlightTool = allTools.find(t => t.id === 'free-claude-code') ||
  allTools.find(t => (t.signal_score || 0) >= 95 && t.primary_alternative) ||
  allTools[0];

// Initial render slice for sub-50ms SSR
const PAGE_SIZE = 24;
const initialTools = allTools.slice(0, PAGE_SIZE);
---

<Layout 
  title="ToolsRadar - Curated Daily Directory of New Developer Tools & AI Apps" 
  description="The high-signal intelligence radar discovering tomorrow's breakout developer utilities, autonomous AI agents, and open-source alternatives."
  canonicalUrl="https://lordorange.top/"
>
  <!-- ==================== TIER 1: HERO & INTERACTIVE RADAR ==================== -->
  <section class="hero-master-section">
    <div class="hero-split-grid">
      <!-- Left Column: Typography & Command Search -->
      <div class="hero-content-col">
        <!-- Live Status Pill -->
        <div class="hero-pulse-badge">
          <span class="live-dot-pulse"></span>
          <span class="pulse-text">LIVE RADAR TELEMETRY • {allTools.length} VERIFIED RELEASES</span>
        </div>

        <!-- Headline -->
        <h1 class="hero-main-title">
          The Intelligence Radar for <br class="hidden-mobile" />
          <span class="gradient-headline">Breakthrough DevTools</span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-lead-text">
          Independent real-time tracking of high-signal software, autonomous AI agents, and privacy-first open-source alternatives before they reach mainstream hype.
        </p>

        <!-- Raycast / Spotlight Style Instant Search Bar -->
        <div class="search-command-wrapper">
          <svg class="search-lens-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="tool-search" 
            class="search-command-input" 
            placeholder="Search 550+ tools, alternatives (Notion, Cursor, Redis), or CLI..." 
            autocomplete="off"
            aria-label="Search tools"
          />
          <div class="search-key-badge" title="Press / anywhere to search">/</div>
        </div>

        <!-- Telemetry Stats Ticker -->
        <div class="hero-telemetry-ticker">
          <div class="ticker-box">
            <span class="ticker-num">{allTools.length}</span>
            <span class="ticker-lbl">Tools Tracked</span>
          </div>
          <div class="ticker-separator"></div>
          <div class="ticker-box">
            <span class="ticker-num">{altCount}+</span>
            <span class="ticker-lbl">OSS Alternatives</span>
          </div>
          <div class="ticker-separator"></div>
          <div class="ticker-box">
            <span class="ticker-num">24H</span>
            <span class="ticker-lbl">Automated Cadence</span>
          </div>
          <div class="ticker-separator"></div>
          <div class="ticker-box">
            <span class="ticker-num">100%</span>
            <span class="ticker-lbl">Vendor Independent</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Radar Scope (Signature Moment) -->
      <div class="hero-radar-col">
        <RadarScope tools={allTools} />
      </div>
    </div>
  </section>

  <!-- ==================== TIER 2: TODAY'S RADAR SPOTLIGHT ==================== -->
  <SpotlightCard tool={spotlightTool} />

  <!-- ==================== TIER 3: CURATED BATTLEGROUND MATRICES ==================== -->
  <BattlegroundSection allTools={allTools} />

  <!-- ==================== TIER 4: FEATURED TECHNICAL GUIDES ==================== -->
  <FeaturedGuides />

  <!-- ==================== TIER 5: LIVE RADAR STREAM FEED ==================== -->
  <section class="radar-feed-master-section" id="radar-feed">
    <!-- Feed Section Title -->
    <div class="feed-section-header">
      <div class="feed-title-wrap">
        <div class="feed-section-pill">
          <span>⚡ ALL RADAR INGESTIONS</span>
        </div>
        <h2 class="feed-section-title">
          Live Radar Stream Feed
        </h2>
      </div>

      <div class="feed-counter-status">
        <span id="results-count" class="feed-counter-badge">
          Showing {initialTools.length} of {allTools.length} Tools
        </span>
      </div>
    </div>

    <!-- Category Carousel Bar -->
    <div class="category-scroll-container">
      <div class="category-chip-track" id="category-bar">
        <button class="category-pill-btn active" data-category="all">
          <span class="pill-icon">⚡</span>
          <span class="pill-text">All Categories</span>
          <span class="pill-count">{allTools.length}</span>
        </button>

        {categoryCounts.map(cat => {
          const iconMap: Record<string, string> = {
            "ai-agents": "🤖",
            "ai-tools": "🧠",
            "developer-tools": "💻",
            "open-source": "🔄",
            "frameworks-libraries": "📦",
            "database-storage": "🗄️",
            "security-devops": "☁️",
            "cybersecurity-reverse": "🛡️",
            "productivity": "⚡",
            "design-ui": "🎨",
            "testing-qa": "🧪",
            "web-scraping-apis": "🌐"
          };
          const catIcon = iconMap[cat.id] || "📁";

          return (
            <button class="category-pill-btn" data-category={cat.id}>
              <span class="pill-icon">{catIcon}</span>
              <span class="pill-text">{cat.name}</span>
              <span class="pill-count">{cat.count}</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Filter Chips & Sort Controls Toolbar -->
    <div class="feed-toolbar-row">
      <!-- Quick Filter Chips -->
      <div class="quick-filters-group" id="feature-filters">
        <button class="filter-toggle-chip active" data-filter="all">
          All Tools
        </button>
        <button class="filter-toggle-chip" data-filter="alternatives">
          <span>🔄 Alternatives</span>
          <span class="chip-bubble">{altCount}</span>
        </button>
        <button class="filter-toggle-chip" data-filter="self-host">
          <span>🐳 Self-Host</span>
          <span class="chip-bubble">{selfHostCount}</span>
        </button>
        <button class="filter-toggle-chip" data-filter="no-signup">
          <span>🔓 No Sign-up</span>
          <span class="chip-bubble">{noSignupCount}</span>
        </button>
        <button class="filter-toggle-chip" data-filter="high-signal">
          <span>🔥 Top Traction</span>
          <span class="chip-bubble">{highSignalCount}</span>
        </button>
      </div>

      <!-- Sort Dropdown -->
      <div class="sort-control-wrap">
        <span class="sort-caption">SORT BY:</span>
        <select id="sort-select" class="sort-dropdown-select" aria-label="Sort tools">
          <option value="signal" selected>⚡ Highest Traction Score</option>
          <option value="stars">★ Most GitHub Stars</option>
          <option value="newest">🆕 Recently Added</option>
        </select>
      </div>
    </div>

    <!-- Empty Results State -->
    <div id="no-results" class="empty-results-box" style="display: none;">
      <div class="empty-icon">🔍</div>
      <h3 class="empty-title">No radar targets match your criteria</h3>
      <p class="empty-desc">Try relaxing your search terms, clearing active category filters, or resetting filter options.</p>
      <button id="reset-filters-btn" class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.45rem 1.1rem; border-radius: 8px;">
        Reset All Filters
      </button>
    </div>

    <!-- Tools Cards Grid -->
    <div class="tools-cards-grid" id="tools-container">
      {initialTools.map(tool => {
        const iconUrl = getToolIcon(tool.url, tool.github_url);
        const initial = tool.name.charAt(0);
        const searchCorpus = `${tool.name} ${tool.tagline} ${tool.category} ${(tool.tags || []).join(" ")} ${tool.primary_alternative || ""}`.toLowerCase();

        return (
          <article 
            class="cyber-tool-card" 
            data-id={tool.id}
            data-corpus={searchCorpus}
            data-category={tool.category}
            data-self-host={tool.is_self_hostable ? "true" : "false"}
            data-no-signup={tool.no_signup_required ? "true" : "false"}
            data-has-alt={tool.primary_alternative ? "true" : "false"}
            data-signal={tool.signal_score || 0}
            data-stars={tool.stars || 0}
          >
            <!-- Card Body Top -->
            <div>
              <div class="card-header-row">
                <div class="tool-brand-icon">
                  {iconUrl ? (
                    <img 
                      src={iconUrl} 
                      alt={`${tool.name} icon`} 
                      loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="tool-fallback-monogram" style="display: none;">
                      {initial}
                    </div>
                  ) : (
                    <div class="tool-fallback-monogram">
                      {initial}
                    </div>
                  )}
                </div>

                <div class="tool-header-text">
                  <div class="tool-name-line">
                    <h3 class="tool-heading">
                      <a href={`/tool/${tool.id}`}>
                        {tool.name}
                      </a>
                    </h3>

                    <div class="tool-telemetry-badges">
                      {tool.stars > 0 && (
                        <span class="stars-telemetry-badge">
                          <span>★</span>
                          <span>{tool.stars > 999 ? `${(tool.stars / 1000).toFixed(1)}k` : tool.stars}</span>
                        </span>
                      )}
                      {tool.signal_score && (
                        <span class="signal-telemetry-badge">
                          ⚡{tool.signal_score}
                        </span>
                      )}
                    </div>
                  </div>

                  <p class="tool-tagline-text">{tool.tagline}</p>
                </div>
              </div>

              <!-- Badges & Alternative Row -->
              <div class="tool-chips-row">
                {tool.primary_alternative && (
                  <span class="chip-alt">
                    🔄 Alt to {tool.primary_alternative}
                  </span>
                )}

                {tool.is_self_hostable && (
                  <span class="chip-selfhost">
                    🐳 Self-Host
                  </span>
                )}

                {tool.no_signup_required && (
                  <span class="chip-nosignup">
                    🔓 No Sign-up
                  </span>
                )}

                {(tool.tags || []).slice(0, 3).map(tag => (
                  <span class="chip-tag">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card Footer -->
            <div class="card-bottom-bar">
              <div class="card-license-tags">
                <span class={tool.pricing_model === "Open Source" ? "badge badge-oss" : "badge badge-free"}>
                  {tool.pricing_model}
                </span>
                <span class="badge badge-source">
                  {tool.source === "github_trending" ? "GitHub" : tool.source === "producthunt" ? "PH" : "HN"}
                </span>
              </div>

              <a href={`/tool/${tool.id}`} class="card-action-link">
                <span>Dossier & Alternatives</span>
                <span>→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Load More Button -->
    <div id="load-more-wrapper" class="load-more-container">
      <button id="load-more-btn" class="btn btn-secondary load-more-action-btn">
        <span>Load More Radar Targets</span>
        <span id="load-more-counter" class="load-more-counter-text">
          ({initialTools.length} / {allTools.length})
        </span>
      </button>
    </div>
  </section>
</Layout>

<script>
  // Full client-side tools data for instant search and pagination
  let allToolsData = [];
  let filteredTools = [];
  let displayedCount = 24;
  const BATCH_SIZE = 24;

  const searchInput = document.getElementById('tool-search');
  const toolsContainer = document.getElementById('tools-container');
  const resultsCount = document.getElementById('results-count');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreWrapper = document.getElementById('load-more-wrapper');
  const loadMoreCounter = document.getElementById('load-more-counter');
  const noResults = document.getElementById('no-results');
  const resetFiltersBtn = document.getElementById('reset-filters-btn');
  const sortSelect = document.getElementById('sort-select');

  let activeCategory = 'all';
  let activeFeatureFilter = 'all';
  let activeSort = 'signal';
  let searchQuery = '';

  // Extract initial cards data from DOM
  function initToolsData() {
    const cardElements = document.querySelectorAll('.cyber-tool-card');
    const existingIds = new Set();
    const domTools = [];

    cardElements.forEach(card => {
      const id = card.getAttribute('data-id');
      existingIds.add(id);
      domTools.push({
        id,
        corpus: card.getAttribute('data-corpus') || '',
        category: card.getAttribute('data-category') || '',
        selfHost: card.getAttribute('data-self-host') === 'true',
        noSignup: card.getAttribute('data-no-signup') === 'true',
        hasAlt: card.getAttribute('data-has-alt') === 'true',
        signal: parseInt(card.getAttribute('data-signal') || '0', 10),
        stars: parseInt(card.getAttribute('data-stars') || '0', 10),
        element: card
      });
    });

    allToolsData = domTools;
    filteredTools = [...allToolsData];
  }

  initToolsData();

  // Lazy fetch complete search corpus if search is typed
  let fullDatasetLoaded = false;
  async function loadFullDataset() {
    if (fullDatasetLoaded) return;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        const fullList = await res.json();
        // Merge full list with existing
        const existingIds = new Set(allToolsData.map(t => t.id));
        fullList.forEach(t => {
          if (!existingIds.has(t.id)) {
            allToolsData.push({
              id: t.id,
              name: t.name,
              tagline: t.tagline,
              corpus: `${t.name} ${t.tagline} ${t.category} ${(t.tags || []).join(" ")} ${t.primary_alternative || ""}`.toLowerCase(),
              category: t.category,
              selfHost: !!t.is_self_hostable,
              noSignup: !!t.no_signup_required,
              hasAlt: !!t.primary_alternative,
              signal: t.signal_score || 0,
              stars: t.stars || 0,
              pricing: t.pricing_model || 'Free',
              source: t.source || 'github_trending',
              alt: t.primary_alternative,
              tags: t.tags || [],
              url: t.url,
              github_url: t.github_url,
              element: null
            });
          }
        });
        fullDatasetLoaded = true;
        applyFilters();
      }
    } catch (_) {}
  }

  // Card cursor spotlight glow handler
  function attachCardGlow() {
    document.querySelectorAll('.cyber-tool-card').forEach(card => {
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  }

  attachCardGlow();

  // Render a tool card dynamically
  function createCardElement(t) {
    const article = document.createElement('article');
    article.className = 'cyber-tool-card';
    article.setAttribute('data-id', t.id);
    article.setAttribute('data-category', t.category);
    article.setAttribute('data-signal', t.signal);
    article.setAttribute('data-stars', t.stars);

    const initial = t.name.charAt(0);
    const starLabel = t.stars > 999 ? `${(t.stars / 1000).toFixed(1)}k` : t.stars;
    const badgeClass = t.pricing === 'Open Source' ? 'badge badge-oss' : 'badge badge-free';
    const sourceLabel = t.source === 'github_trending' ? 'GitHub' : (t.source === 'producthunt' ? 'PH' : 'HN');

    article.innerHTML = `
      <div>
        <div class="card-header-row">
          <div class="tool-brand-icon">
            <div class="tool-fallback-monogram">${initial}</div>
          </div>
          <div class="tool-header-text">
            <div class="tool-name-line">
              <h3 class="tool-heading">
                <a href="/tool/${t.id}">${t.name}</a>
              </h3>
              <div class="tool-telemetry-badges">
                ${t.stars > 0 ? `<span class="stars-telemetry-badge"><span>★</span><span>${starLabel}</span></span>` : ''}
                ${t.signal > 0 ? `<span class="signal-telemetry-badge">⚡${t.signal}</span>` : ''}
              </div>
            </div>
            <p class="tool-tagline-text">${t.tagline}</p>
          </div>
        </div>
        <div class="tool-chips-row">
          ${t.alt ? `<span class="chip-alt">🔄 Alt to ${t.alt}</span>` : ''}
          ${t.selfHost ? `<span class="chip-selfhost">🐳 Self-Host</span>` : ''}
          ${t.noSignup ? `<span class="chip-nosignup">🔓 No Sign-up</span>` : ''}
          ${(t.tags || []).slice(0, 3).map(tag => `<span class="chip-tag">#${tag}</span>`).join('')}
        </div>
      </div>
      <div class="card-bottom-bar">
        <div class="card-license-tags">
          <span class="${badgeClass}">${t.pricing}</span>
          <span class="badge badge-source">${sourceLabel}</span>
        </div>
        <a href="/tool/${t.id}" class="card-action-link">
          <span>Dossier & Alternatives</span>
          <span>→</span>
        </a>
      </div>
    `;

    article.addEventListener('pointermove', (e) => {
      const rect = article.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      article.style.setProperty('--mouse-x', `${x}px`);
      article.style.setProperty('--mouse-y', `${y}px`);
    });

    return article;
  }

  // Filter & Sort Logic
  function applyFilters() {
    filteredTools = allToolsData.filter(t => {
      // Category filter
      if (activeCategory !== 'all' && t.category !== activeCategory) {
        return false;
      }
      // Feature filter
      if (activeFeatureFilter === 'alternatives' && !t.hasAlt) return false;
      if (activeFeatureFilter === 'self-host' && !t.selfHost) return false;
      if (activeFeatureFilter === 'no-signup' && !t.noSignup) return false;
      if (activeFeatureFilter === 'high-signal' && t.signal < 80) return false;

      // Keyword query
      if (searchQuery) {
        const queryTerms = searchQuery.split(/\s+/).filter(Boolean);
        return queryTerms.every(term => t.corpus.includes(term));
      }
      return true;
    });

    // Sorting
    if (activeSort === 'stars') {
      filteredTools.sort((a, b) => b.stars - a.stars);
    } else if (activeSort === 'signal') {
      filteredTools.sort((a, b) => b.signal - a.signal);
    }

    renderGrid();
  }

  function renderGrid() {
    toolsContainer.innerHTML = '';
    const slice = filteredTools.slice(0, displayedCount);

    if (slice.length === 0) {
      noResults.style.display = 'block';
      toolsContainer.style.display = 'none';
      loadMoreWrapper.style.display = 'none';
    } else {
      noResults.style.display = 'none';
      toolsContainer.style.display = 'grid';

      slice.forEach(t => {
        if (!t.element) {
          t.element = createCardElement(t);
        }
        toolsContainer.appendChild(t.element);
      });

      // Update load more visibility
      if (displayedCount >= filteredTools.length) {
        loadMoreWrapper.style.display = 'none';
      } else {
        loadMoreWrapper.style.display = 'block';
        loadMoreCounter.textContent = `(${displayedCount} / ${filteredTools.length})`;
      }
    }

    // Update results badge
    if (resultsCount) {
      resultsCount.textContent = `Showing ${Math.min(displayedCount, filteredTools.length)} of ${filteredTools.length} Tools`;
    }
  }

  // Event Listeners: Search Input
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      displayedCount = BATCH_SIZE;
      loadFullDataset();
      applyFilters();
    });

    // Keyboard shortcut /
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput.focus();
      }
    });
  }

  // Category Buttons
  document.querySelectorAll('.category-pill-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.category-pill-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.getAttribute('data-category') || 'all';
      displayedCount = BATCH_SIZE;
      loadFullDataset();
      applyFilters();
    });
  });

  // Feature Filter Chips
  document.querySelectorAll('.filter-toggle-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.filter-toggle-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      activeFeatureFilter = chip.getAttribute('data-filter') || 'all';
      displayedCount = BATCH_SIZE;
      loadFullDataset();
      applyFilters();
    });
  });

  // Sort Dropdown
  if (sortSelect) {
    sortSelect.addEventListener('change', (e) => {
      activeSort = e.target.value;
      loadFullDataset();
      applyFilters();
    });
  }

  // Load More Button
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      displayedCount += BATCH_SIZE;
      loadFullDataset();
      renderGrid();
    });
  }

  // Reset Filters
  if (resetFiltersBtn) {
    resetFiltersBtn.addEventListener('click', () => {
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      activeCategory = 'all';
      activeFeatureFilter = 'all';
      activeSort = 'signal';
      document.querySelectorAll('.category-pill-btn').forEach(b => b.classList.remove('active'));
      document.querySelector('.category-pill-btn[data-category="all"]')?.classList.add('active');
      document.querySelectorAll('.filter-toggle-chip').forEach(c => c.classList.remove('active'));
      document.querySelector('.filter-toggle-chip[data-filter="all"]')?.classList.add('active');
      if (sortSelect) sortSelect.value = 'signal';
      displayedCount = BATCH_SIZE;
      applyFilters();
    });
  }
</script>

<style>
  /* ==================== TIER 1: HERO ==================== */
  .hero-master-section {
    padding: 3.5rem 0 2rem;
    position: relative;
  }

  .hero-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-split-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3.5rem;
    }
  }

  .hero-pulse-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.28);
    color: #38bdf8;
    font-size: 0.76rem;
    font-weight: 700;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
  }

  .live-dot-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 10px #38bdf8;
    animation: livePulse 1.8s infinite;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }

  .hero-main-title {
    font-size: clamp(2.3rem, 4.2vw, 3.6rem);
    font-weight: 800;
