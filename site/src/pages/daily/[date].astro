---
import Layout from '../../layouts/Layout.astro';
import allTools from '../../../../data/all_tools.json';

export function getStaticPaths() {
  const dates = [...new Set(allTools.map(t => t.date_added).filter(Boolean))];
  return dates.map(date => ({
    params: { date },
    props: { 
      date,
      tools: allTools.filter(t => t.date_added === date)
    }
  }));
}

const { date, tools } = Astro.props;
---

<Layout 
  title={`New Tools & Products Launched on ${date} - DailyRadar`}
  description={`Browse the daily batch of ${tools.length} newly released developer tools, AI apps, and open-source projects discovered on ${date}.`}
  canonicalUrl={`https://radar.yourdomain.com/daily/${date}`}
>
  <nav style="display: flex; gap: 0.5rem; align-items: center; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">
    <a href="/">Home</a>
    <span>/</span>
    <span>Daily Archives</span>
    <span>/</span>
    <span style="color: var(--text-secondary);">{date}</span>
  </nav>

  <header style="padding: 1.5rem 0 2rem; border-bottom: 1px solid var(--card-border); margin-bottom: 2rem;">
    <h1 style="font-size: 2.2rem; font-weight: 800; margin-bottom: 0.5rem;">
      Daily Drops: {date}
    </h1>
    <p style="color: var(--text-secondary); font-size: 1.1rem;">
      {tools.length} new software releases, indie projects, and open source repositories indexed today.
    </p>
  </header>

  <div class="tools-grid">
    {tools.map(tool => (
      <article class="tool-card">
        <div>
          <div class="tool-header">
            <span class="badge badge-category">{tool.category.replace("-", " ")}</span>
            <span class="badge badge-pricing">{tool.pricing_model}</span>
          </div>
          <h2 class="tool-title" style="margin-bottom: 0.4rem;">
            <a href={`/tool/${tool.id}`}>{tool.name}</a>
          </h2>
          <p class="tool-tagline">{tool.tagline}</p>
        </div>
        <div class="tool-footer">
          <span>via {tool.source.replace("_", " ")}</span>
          <a href={`/tool/${tool.id}`} style="font-weight: 600; font-size: 0.85rem;">
            Details & Alternatives →
          </a>
        </div>
      </article>
    ))}
  </div>
</Layout>
