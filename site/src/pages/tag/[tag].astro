---
import Layout from '../../layouts/Layout.astro';
import allTools from '../../../../data/all_tools.json';
import { getToolIcon } from '../../utils/favicon';

export function getStaticPaths() {
  const tagMap = new Map();

  allTools.forEach(tool => {
    (tool.tags || []).forEach((rawTag: string) => {
      const trimmed = (rawTag || '').trim();
      if (!trimmed) return;
      const slug = trimmed.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      if (!slug || slug.length < 2) return;

      if (!tagMap.has(slug)) {
        tagMap.set(slug, {
          slug,
          displayName: trimmed,
          tools: []
        });
      }
      tagMap.get(slug).tools.push(tool);
    });
  });

  // Only create indexable tag landing hubs for tags with >= 3 tools to ensure rich content density
  return Array.from(tagMap.values())
    .filter(item => item.tools.length >= 3)
    .map(tagItem => {
      // Sort tools in this tag: highest signal score first, then stars
      tagItem.tools.sort((a: any, b: any) => (b.signal_score || 0) - (a.signal_score || 0) || (b.stars || 0) - (a.stars || 0));
      return {
        params: { tag: tagItem.slug },
        props: { tagItem }
      };
    });
}

interface Props {
  tagItem: {
    slug: string;
    displayName: string;
    tools: any[];
  };
}

const { tagItem } = Astro.props;
const { slug, displayName, tools } = tagItem;

const pageTitle = `Best ${displayName} Developer Tools & Software (2026) | ToolsRadar`;
const metaDesc = `Discover ${tools.length} top-ranked ${displayName} developer tools, open-source utilities, and AI applications. Audited with in-depth engineering dossiers and telemetry on ToolsRadar.`;
const canonical = `https://lordorange.top/tag/${slug}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      "name": pageTitle,
      "description": metaDesc,
      "url": canonical
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://lordorange.top"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tags",
          "item": "https://lordorange.top/tag"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": displayName,
          "item": canonical
        }
      ]
    }
  ]
};

// Popular related tags for cross-linking
const popularTags = [
  { name: 'AI Agents', slug: 'ai-agents' },
  { name: 'Open Source', slug: 'open-source' },
  { name: 'Developer Tools', slug: 'developer-tools' },
  { name: 'CLI', slug: 'cli' },
  { name: 'MCP', slug: 'mcp' },
  { name: 'Rust', slug: 'rust' },
  { name: 'Automation', slug: 'automation' },
  { name: 'Productivity', slug: 'productivity' },
  { name: 'Security', slug: 'security' },
  { name: 'Docker', slug: 'docker' },
  { name: 'TypeScript', slug: 'typescript' },
  { name: 'Python', slug: 'python' }
].filter(t => t.slug !== slug);
---

<Layout 
  title={pageTitle}
  description={metaDesc}
  canonicalUrl={canonical}
  jsonLd={jsonLd}
>
  <nav class="breadcrumb-nav" style="display: flex; gap: 0.5rem; align-items: center; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 2rem;">
    <a href="/" style="color: var(--text-muted); text-decoration: none;">Radar</a>
    <span>/</span>
    <a href="/tag" style="color: var(--text-muted); text-decoration: none;">Tags</a>
    <span>/</span>
    <span style="color: var(--text-secondary);">#{displayName}</span>
  </nav>

  <header style="padding: 1.5rem 0 2rem; border-bottom: 1px solid var(--border-subtle); margin-bottom: 2rem;">
    <div style="display: inline-block; margin-bottom: 0.75rem;">
      <span class="badge badge-source" style="font-size: 0.8rem; padding: 0.25rem 0.65rem;">
        Tag Matrix Hub
      </span>
    </div>

    <h1 style="font-size: 2.4rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.6rem;" class="gradient-title">
      Top #{displayName} Tools
    </h1>
    <p style="color: var(--text-secondary); font-size: 1.1rem; max-width: 720px; line-height: 1.6;">
      Explore {tools.length} curated, production-audited software projects tagged with <strong>#{displayName}</strong>. Includes client-side utilities, backend frameworks, and open-source alternatives.
    </p>

    <div style="margin-top: 1.25rem; display: flex; gap: 0.75rem; align-items: center;">
      <span class="badge badge-oss">
        {tools.length} Verified Releases
      </span>
      <span class="badge badge-free" style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border-color: rgba(56, 189, 248, 0.25);">
        Updated Daily
      </span>
    </div>
  </header>

  <section>
    <div class="tools-grid">
      {tools.map((tool: any) => {
        const iconUrl = getToolIcon(tool.url, tool.github_url);
        const initial = tool.name.charAt(0);

        return (
          <article class="tool-card">
            <div>
              <div class="tool-card-top">
                <div class="tool-icon">
                  {iconUrl ? (
                    <img 
                      src={iconUrl} 
                      alt={`${tool.name} icon`} 
                      loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="tool-icon-fallback" style="display: none;">
                      {initial}
                    </div>
                  ) : (
                    <div class="tool-icon-fallback">
                      {initial}
                    </div>
                  )}
                </div>

                <div class="tool-meta-header">
                  <div class="tool-title-row">
                    <h2 class="tool-title">
                      <a href={`/tool/${tool.id}`} style="color: var(--text-primary); text-decoration: none;">
                        {tool.name}
                      </a>
                    </h2>
                    {tool.stars > 0 && (
                      <span class="stars-badge">
                        <span>★</span>
                        <span>{tool.stars > 999 ? `${(tool.stars / 1000).toFixed(1)}k` : tool.stars}</span>
                      </span>
                    )}
                    {tool.signal_score && (
                      <span class="stars-badge" style="color: #38bdf8; border-color: rgba(56, 189, 248, 0.25); background: rgba(56, 189, 248, 0.08);">
                        ⚡{tool.signal_score}
                      </span>
                    )}
                  </div>
                  <p class="tool-tagline">{tool.tagline}</p>
                </div>
              </div>

              {tool.tags && tool.tags.length > 0 && (
                <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.85rem;">
                  {tool.tags.slice(0, 4).map((tagStr: string) => {
                    const tSlug = tagStr.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
                    return (
                      <a 
                        href={`/tag/${tSlug}`}
                        style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.07); color: #a1a1aa; font-size: 0.72rem; padding: 0.15rem 0.45rem; border-radius: 4px; text-decoration: none;"
                      >
                        #{tagStr}
                      </a>
                    );
                  })}
                </div>
              )}
            </div>

            <div class="tool-footer">
              <span class={tool.pricing_model === "Open Source" ? "badge badge-oss" : "badge badge-free"}>
                {tool.pricing_model}
              </span>

              <a href={`/tool/${tool.id}`} style="display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 600; font-size: 0.82rem; color: var(--accent); text-decoration: none;">
                Read Dossier →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Related Popular Tags Matrix -->
  <section style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border-subtle);">
    <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem;">
      Explore Other High-Signal Developer Tags
    </h3>
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
      {popularTags.map(pt => (
        <a 
          href={`/tag/${pt.slug}`}
          style="background: rgba(18, 18, 23, 0.8); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 0.45rem 0.85rem; font-size: 0.85rem; color: var(--text-secondary); text-decoration: none; transition: all 0.2s ease;"
        >
          #{pt.name}
        </a>
      ))}
      <a 
        href="/tag"
        style="background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 8px; padding: 0.45rem 0.85rem; font-size: 0.85rem; color: #38bdf8; text-decoration: none; font-weight: 600;"
      >
        View All Tags →
      </a>
    </div>
  </section>
</Layout>
