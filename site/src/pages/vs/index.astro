---
import Layout from '../../layouts/Layout.astro';
import { comparisonPairs } from '../../data/comparisons';
import categories from '../../../../data/categories.json';

const featuredPairs = comparisonPairs.filter(p => p.isFeaturedPair).slice(0, 12);
const regularPairs = comparisonPairs.filter(p => !p.isFeaturedPair);

const pageTitle = "Head-to-Head Developer Software Comparisons & Benchmarks | ToolsRadar";
const metaDesc = `Browse ${comparisonPairs.length}+ side-by-side software comparisons. Objective benchmarks comparing open-source sovereignty, SaaS pricing tiers, Docker self-hosting, and engineering trade-offs.`;
const canonical = "https://lordorange.top/vs";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Developer Software Comparisons & Benchmarks - ToolsRadar",
  "description": metaDesc,
  "url": canonical
};
---

<Layout
  title={pageTitle}
  description={metaDesc}
  canonicalUrl={canonical}
  jsonLd={jsonLd}
>
  <div class="vs-hub-container">
    <!-- Header -->
    <header class="vs-hub-header">
      <div class="vs-pill">
        <span>⚡ ToolsRadar Comparison Engine</span>
      </div>
      <h1 class="vs-hub-title">
        Head-to-Head <span class="gradient-text">Software Benchmarks</span>
      </h1>
      <p class="vs-hub-subtitle">
        Objective side-by-side architectural comparisons, pricing analyses, and data sovereignty evaluations across {comparisonPairs.length} head-to-head developer tool pairings.
      </p>
    </header>

    <!-- Featured Battles -->
    {featuredPairs.length > 0 && (
      <section class="featured-section">
        <div class="section-title-row">
          <span class="fire-icon">🔥</span>
          <h2>Featured Developer Matchups</h2>
        </div>
        <div class="featured-grid">
          {featuredPairs.map(p => (
            <article class="featured-card">
              <div class="card-top">
                <span class="category-tag">{p.category}</span>
                <span class="vs-badge">VS</span>
              </div>
              <h3 class="card-title">
                <a href={`/vs/${p.slug}`}>
                  <span class="tool-a-name">{p.toolA.name}</span>
                  <span class="vs-small">vs</span>
                  <span class="tool-b-name">{p.toolBName}</span>
                </a>
              </h3>
              <p class="card-summary">{p.comparisonText}</p>
              <div class="card-footer">
                <span class="license-pill">{p.toolA.pricing_model}</span>
                <a href={`/vs/${p.slug}`} class="compare-link">
                  Compare Specs →
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- All Comparisons Directory -->
    <section class="all-comparisons-section">
      <div class="section-title-row">
        <span class="fire-icon">📚</span>
        <h2>All Software Pairings ({comparisonPairs.length})</h2>
      </div>

      <div class="comparisons-table-card">
        <div class="table-search-row">
          <input 
            type="text" 
            id="vsSearchInput" 
            placeholder="Filter comparisons (e.g., Postiz, Buffer, OpenAI, Docker)..." 
            class="search-input"
          />
        </div>

        <div class="pairs-grid" id="pairsGrid">
          {comparisonPairs.map(p => (
            <a href={`/vs/${p.slug}`} class="pair-row-link" data-search={`${p.toolA.name} ${p.toolBName} ${p.category} ${p.toolA.pricing_model}`.toLowerCase()}>
              <div class="pair-main">
                <span class="pair-name-a">{p.toolA.name}</span>
                <span class="pair-vs-text">vs</span>
                <span class="pair-name-b">{p.toolBName}</span>
              </div>
              <div class="pair-meta">
                <span class="pair-cat">{p.category}</span>
                <span class="pair-tag">{p.toolA.pricing_model}</span>
                <span class="pair-arrow">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script>
    const searchInput = document.getElementById('vsSearchInput') as HTMLInputElement | null;
    const pairsGrid = document.getElementById('pairsGrid');

    if (searchInput && pairsGrid) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        const items = pairsGrid.querySelectorAll('.pair-row-link');
        
        items.forEach((item) => {
          const text = item.getAttribute('data-search') || '';
          if (!query || text.includes(query)) {
            (item as HTMLElement).style.display = 'flex';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    }
  </script>

  <style>
    .vs-hub-container {
      max-width: 1160px;
      margin: 0 auto;
      padding: 3rem 1.25rem 6rem;
    }

    .vs-hub-header {
      text-align: center;
      margin-bottom: 3.5rem;
    }
    .vs-pill {
      display: inline-flex;
      align-items: center;
      padding: 0.35rem 0.95rem;
      border-radius: 9999px;
      background: rgba(56, 189, 248, 0.08);
      border: 1px solid rgba(56, 189, 248, 0.25);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #38bdf8;
      margin-bottom: 1.25rem;
    }
    .vs-hub-title {
      font-size: 3rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #ffffff;
      line-height: 1.15;
      margin-bottom: 1rem;
    }
    .gradient-text {
      background: linear-gradient(135deg, #38bdf8 0%, #a855f7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .vs-hub-subtitle {
      max-width: 720px;
      margin: 0 auto;
      font-size: 1.12rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .section-title-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 1.5rem;
    }
    .section-title-row h2 {
      font-size: 1.45rem;
      font-weight: 800;
      color: #ffffff;
      margin: 0;
    }

    /* Featured Grid */
    .featured-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
      margin-bottom: 3.5rem;
    }
    .featured-card {
      background: linear-gradient(180deg, #0f1420 0%, #0a0d15 100%);
      border: 1px solid rgba(56, 189, 248, 0.2);
      border-radius: 14px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s ease;
    }
    .featured-card:hover {
      border-color: #38bdf8;
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(56, 189, 248, 0.08);
    }
    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .category-tag {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94a3b8;
    }
    .vs-badge {
      font-size: 0.7rem;
      font-weight: 800;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      background: rgba(168, 85, 247, 0.15);
      border: 1px solid rgba(168, 85, 247, 0.3);
      color: #c084fc;
    }
    .card-title {
      font-size: 1.25rem;
      font-weight: 800;
      margin: 0 0 0.75rem;
      line-height: 1.3;
    }
    .card-title a {
      color: #ffffff;
      text-decoration: none;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .tool-a-name {
      color: #38bdf8;
    }
    .tool-b-name {
      color: #ffffff;
    }
    .vs-small {
      color: #64748b;
      font-size: 0.85rem;
      font-weight: 600;
    }
    .card-summary {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.55;
      margin-bottom: 1.25rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }
    .license-pill {
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: rgba(34, 197, 94, 0.1);
      color: #4ade80;
      border: 1px solid rgba(34, 197, 94, 0.2);
    }
    .compare-link {
      font-size: 0.85rem;
      font-weight: 700;
      color: #38bdf8;
      text-decoration: none;
    }
    .compare-link:hover {
      text-decoration: underline;
    }

    /* All Comparisons */
    .comparisons-table-card {
      background: #0b0f17;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 1.5rem;
    }
    .table-search-row {
      margin-bottom: 1.25rem;
    }
    .search-input {
      width: 100%;
      padding: 0.85rem 1.2rem;
      border-radius: 8px;
      background: #05070c;
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #ffffff;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s ease;
    }
    .search-input:focus {
      border-color: #38bdf8;
    }

    .pairs-grid {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-height: 800px;
      overflow-y: auto;
      padding-right: 0.5rem;
    }
    .pair-row-link {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.85rem 1.2rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .pair-row-link:hover {
      background: rgba(56, 189, 248, 0.05);
      border-color: rgba(56, 189, 248, 0.25);
      transform: translateX(4px);
    }
    .pair-main {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 700;
      font-size: 0.98rem;
    }
    .pair-name-a {
      color: #ffffff;
    }
    .pair-vs-text {
      color: #64748b;
      font-size: 0.82rem;
      font-weight: 600;
    }
    .pair-name-b {
      color: #94a3b8;
    }
    .pair-meta {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .pair-cat {
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .pair-tag {
      font-size: 0.72rem;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.05);
      color: #94a3b8;
    }
    .pair-arrow {
      color: #38bdf8;
      font-size: 1.1rem;
    }

    @media (max-width: 640px) {
      .vs-hub-title {
        font-size: 2.1rem;
      }
      .pair-row-link {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
      .pair-meta {
        width: 100%;
        justify-content: space-between;
      }
    }
  </style>
</Layout>
