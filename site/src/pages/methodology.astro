---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Editorial & Review Methodology - ToolsRadar",
  "description": "Learn how ToolsRadar discovers, verifies, tests, and scores developer software, AI agents, and open-source tools with objective criteria.",
  "url": "https://lordorange.top/methodology"
};
---

<Layout 
  title="Editorial & Review Methodology - ToolsRadar"
  description="Transparent review criteria, discovery pipelines, security vetting, and 4-dimension scoring framework powering ToolsRadar."
  canonicalUrl="https://lordorange.top/methodology"
  jsonLd={jsonLd}
>
  <div class="methodology-container">
    <header class="methodology-header">
      <div class="methodology-pill">
        <span>🔬 Transparency & Research Standards</span>
      </div>
      <h1 class="methodology-title">
        Editorial & Review <span class="gradient-text">Methodology</span>
      </h1>
      <p class="methodology-subtitle">
        How we discover, benchmark, test, and evaluate software tools to deliver honest, noise-free intelligence for developers.
      </p>
    </header>

    <!-- Intro Card -->
    <div class="info-card">
      <h2>Why Methodological Rigor Matters</h2>
      <p>
        The developer software landscape is plagued by paid placements, sponsored reviews masquerading as authentic rankings, and empty marketing copy. At <strong>ToolsRadar</strong>, our goal is to build the definitive, trustworthy radar for engineering utilities.
      </p>
      <p>
        Every tool cataloged in our directory is evaluated through an objective, multi-stage pipeline combining automated code audits, community velocity tracking, and hands-on developer testing.
      </p>
    </div>

    <!-- The 5 Evaluation Pillars -->
    <section class="pillars-container">
      <h2 class="section-title">The 5 Pillars of ToolsRadar Evaluation</h2>

      <!-- Pillar 1 -->
      <div class="methodology-step">
        <div class="step-num">01</div>
        <div class="step-content">
          <h3>Automated Multi-Source Discovery</h3>
          <p>
            Rather than relying solely on press releases or inbound marketing, our discovery crawlers scan the web every 24 hours across primary developer ecosystems:
          </p>
          <ul>
            <li><strong>GitHub Trending & New Repositories:</strong> Identifying rapid star acceleration, active commit velocity, and genuine community forks.</li>
            <li><strong>Hacker News (Show HN):</strong> Capturing grassroots launches by systems engineers, indie hackers, and research scientists.</li>
            <li><strong>Product Hunt & Indie Hackers:</strong> Monitoring innovative SaaS launches, AI agent workflows, and productivity tools.</li>
            <li><strong>Open Source Community Submissions:</strong> Peer-reviewed submissions from project maintainers and developers.</li>
          </ul>
        </div>
      </div>

      <!-- Pillar 2 -->
      <div class="methodology-step">
        <div class="step-num">02</div>
        <div class="step-content">
          <h3>Code Auditability, Licensing & Security Vetting</h3>
          <p>
            Before any project is cataloged, we inspect its foundational architectural attributes:
          </p>
          <ul>
            <li><strong>License Verification:</strong> We strictly verify whether a project is genuinely OSI-approved Open Source (MIT, Apache 2.0, BSD, GPL, AGPL), Source-Available (BSL, SSPL), or proprietary commercial software.</li>
            <li><strong>Dependency Hygiene:</strong> We check for basic repository health, recent releases, unresolved critical vulnerabilities, and maintenance activity. Abandoned or unmaintained projects are excluded or flagged.</li>
            <li><strong>Self-Hostability & Privacy:</strong> We verify whether the software can be run locally via Docker, Podman, or standalone binaries without mandatory telemetry phone-homes.</li>
          </ul>
        </div>
      </div>

      <!-- Pillar 3 -->
      <div class="methodology-step">
        <div class="step-num">03</div>
        <div class="step-content">
          <h3>The ToolsRadar Traction & Signal Score</h3>
          <p>
            Each tool receives a dynamic <strong>Traction Signal Score (0–100)</strong> calculated using an algorithmic formula balancing velocity with sustainability:
          </p>
          <div class="formula-box">
            <code>Signal Score = (Star Velocity × 0.35) + (Commit Cadence × 0.25) + (Community Discussions × 0.20) + (Release Stability × 0.20)</code>
          </div>
          <p>
            This ensures that mature, stable tools are not overshadowed by ephemeral 1-day viral repositories that get abandoned immediately after launch.
          </p>
        </div>
      </div>

      <!-- Pillar 4 -->
      <div class="methodology-step">
        <div class="step-num">04</div>
        <div class="step-content">
          <h3>The 4-Dimension Hands-on Scorecard</h3>
          <p>
            On individual tool detail pages, our editorial team evaluates four essential practical developer dimensions:
          </p>
          <div class="scorecard-demo-grid">
            <div class="scorecard-demo-item">
              <span class="demo-icon">🚀</span>
              <h4>Setup & Onboarding</h4>
              <p>How quickly can an engineer get running? Does it require 10 env vars and complex databases, or a clean <code>docker compose up</code> or single binary?</p>
            </div>
            <div class="scorecard-demo-item">
              <span class="demo-icon">🛡️</span>
              <h4>Code & Auditability</h4>
              <p>Is the source code transparent, well-commented, and free from telemetry bloat? Are architecture diagrams and security models clearly documented?</p>
            </div>
            <div class="scorecard-demo-item">
              <span class="demo-icon">👥</span>
              <h4>Community & Vitality</h4>
              <p>Are GitHub issues answered in a timely manner? Is there an active Discord, Discourse, or Slack community? Are pull requests reviewed?</p>
            </div>
            <div class="scorecard-demo-item">
              <span class="demo-icon">💰</span>
              <h4>Cost & Value Advantage</h4>
              <p>Does the free tier provide genuine, non-crippled utility? How does the total cost of ownership compare against incumbent commercial SaaS monopolies?</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Pillar 5 -->
      <div class="methodology-step">
        <div class="step-num">05</div>
        <div class="step-content">
          <h3>Strict Editorial Independence Policy</h3>
          <p>
            Our core commitment to our readers:
          </p>
          <ul>
            <li><strong>No Pay-for-Play:</strong> No company or individual can pay to increase their tool's Traction Score, secure an artificial badge, or alter our Pros & Cons analysis.</li>
            <li><strong>Honest Critique:</strong> If a tool suffers from steep hardware requirements, difficult configuration, or immature documentation, we explicitly document these caveats in the "Things to Consider" section.</li>
            <li><strong>Right of Reply & Correction:</strong> Software maintainers are invited to submit verified documentation updates or corrected installation commands. If our assessment contains a factual inaccuracy, we promptly audit and update the entry.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Maintainer Corrections Box -->
    <div class="cta-card">
      <h2>Are You a Tool Maintainer?</h2>
      <p>
        If your project is listed on ToolsRadar and has recently shipped a major version, changed licensing, or added native Docker support, let our editorial desk know.
      </p>
      <div class="cta-buttons">
        <a href="mailto:hello@lordorange.top?subject=Tool%20Update%20Request" class="btn btn-primary">
          <span>Request an Entry Update</span>
        </a>
        <a href="/submit" class="btn btn-secondary">
          <span>Submit a New Tool</span>
        </a>
        <a href="/contact" class="btn btn-secondary">
          <span>Contact Editorial Team</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .methodology-container {
    max-width: 860px;
    margin: 1.5rem auto 5rem;
    padding: 0 0.5rem;
  }

  .methodology-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .methodology-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #34d399;
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .methodology-title {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .gradient-text {
    background: linear-gradient(135deg, #10b981 0%, #38bdf8 60%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .methodology-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .info-card {
    background: linear-gradient(180deg, rgba(22, 22, 28, 0.7) 0%, rgba(15, 15, 19, 0.85) 100%);
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    padding: 2rem 2.25rem;
    margin-bottom: 3rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .info-card h2 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.015em;
  }

  .info-card p {
    font-size: 1.02rem;
    margin-bottom: 1rem;
  }

  .info-card p:last-child {
    margin-bottom: 0;
  }

  .pillars-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: 1rem;
  }

  .methodology-step {
    background: rgba(18, 18, 23, 0.8);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.75rem 2rem;
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    transition: border-color 0.2s ease;
  }

  .methodology-step:hover {
    border-color: rgba(56, 189, 248, 0.3);
  }

  .step-num {
    width: 44px;
    height: 44px;
    line-height: 44px;
    text-align: center;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    font-size: 1.1rem;
    font-weight: 800;
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  .step-content {
    flex: 1;
    min-width: 0;
  }

  .step-content h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .step-content p {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 0.85rem;
  }

  .step-content ul {
    list-style: disc;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .formula-box {
    background: rgba(8, 8, 12, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.85rem 1.25rem;
    border-radius: 10px;
    margin: 1rem 0;
    overflow-x: auto;
  }

  .formula-box code {
    font-family: var(--font-mono);
    color: #38bdf8;
    font-size: 0.9rem;
  }

  .scorecard-demo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .scorecard-demo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .scorecard-demo-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .demo-icon {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .scorecard-demo-item h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }

  .scorecard-demo-item p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .cta-card {
    background: radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.15) 0%, rgba(18, 18, 23, 0.9) 70%);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 18px;
    padding: 2.5rem 2rem;
    text-align: center;
    margin-top: 3.5rem;
  }

  .cta-card h2 {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .cta-card p {
    font-size: 1.02rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 1.5rem;
    line-height: 1.6;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>
