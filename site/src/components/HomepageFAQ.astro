---
import { homepageFaqs } from '../data/faqs';
---

<section class="faq-radar-section" id="radar-faq" aria-labelledby="faq-heading">
  <div class="faq-inner">
    <!-- Header -->
    <div class="faq-section-header">
      <div class="faq-pill">
        <span>💬 KNOWLEDGE BASE & TRANSPARENCY</span>
      </div>
      <h2 id="faq-heading" class="faq-heading">
        Frequently Asked <span class="gradient-text">Questions</span>
      </h2>
      <p class="faq-subheading">
        Everything you need to know about our data sources, telemetry scoring, open-source focus, and editorial independence.
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="faq-accordion-list">
      {homepageFaqs.map((faq, index) => (
        <details class="faq-accordion-item" open={index === 0}>
          <summary class="faq-summary">
            <span class="faq-question-text">{faq.question}</span>
            <span class="faq-chevron" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer-content">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Still have questions footer -->
    <div class="faq-support-callout">
      <div class="support-left">
        <span class="support-avatar">📡</span>
        <div>
          <span class="support-title">Have a question or factual update for a tool?</span>
          <p class="support-desc">We welcome corrections, licensing clarifications, and project updates from open-source maintainers and indie creators.</p>
        </div>
      </div>
      <a href="/contact" class="btn-faq-contact">
        <span>Contact Editorial Desk</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .faq-radar-section {
    margin: 4.5rem 0 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .faq-inner {
    width: 100%;
    max-width: 900px;
    margin: 0;
  }

  .faq-section-header {
    text-align: left;
    margin-bottom: 2.5rem;
  }

  .faq-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    background: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.25);
    color: #c084fc;
    font-size: 0.76rem;
    font-weight: 700;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .faq-heading {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin-bottom: 0.85rem;
    color: var(--text-primary);
  }

  .gradient-text {
    background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .faq-subheading {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .faq-heading {
      font-size: 1.55rem;
      line-height: 1.3;
    }
    .faq-subheading {
      font-size: 0.92rem;
    }
    .faq-summary {
      padding: 1rem 1.15rem;
      font-size: 0.95rem;
    }
    .faq-answer-content {
      padding: 0 1.15rem 1.15rem 1.15rem;
      font-size: 0.88rem;
    }
    .faq-support-callout {
      padding: 1rem 1.15rem;
      flex-direction: column;
      align-items: stretch;
    }
    .btn-faq-contact {
      justify-content: center;
      width: 100%;
      box-sizing: border-box;
    }
  }

  /* Accordion */
  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .faq-accordion-item {
    background: rgba(18, 18, 23, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-accordion-item[open] {
    border-color: rgba(56, 189, 248, 0.35);
    background: rgba(22, 22, 29, 0.9);
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.4);
  }

  .faq-summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    user-select: none;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:hover {
    color: #38bdf8;
  }

  .faq-question-text {
    flex: 1;
    padding-right: 1.25rem;
    line-height: 1.45;
  }

  .faq-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .faq-accordion-item[open] .faq-chevron {
    transform: rotate(180deg);
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.3);
  }

  .faq-answer-content {
    padding: 0 1.5rem 1.35rem 1.5rem;
    font-size: 0.94rem;
    color: var(--text-secondary);
    line-height: 1.68;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    margin-top: 0.25rem;
    padding-top: 1rem;
  }

  /* Support callout */
  .faq-support-callout {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .support-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    min-width: 260px;
  }

  .support-avatar {
    font-size: 1.6rem;
  }

  .support-title {
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.2rem;
  }

  .support-desc {
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .btn-faq-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.1rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.84rem;
    border-radius: 8px;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .btn-faq-contact:hover {
    background: #38bdf8;
    color: #040810;
    border-color: #38bdf8;
    transform: translateY(-1px);
  }
</style>
