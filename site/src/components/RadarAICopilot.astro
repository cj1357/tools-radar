---
// site/src/components/RadarAICopilot.astro
// Zero-Cost Client-Side Intelligent Architecture Copilot for ToolsRadar
interface Props {
  allTools: Array<{
    id: string;
    name: string;
    tagline: string;
    summary: string;
    category: string;
    pricing_model: string;
    stars?: number;
    signal_score?: number;
    is_self_hostable?: boolean;
    no_signup_required?: boolean;
    primary_alternative?: string;
    url: string;
    github_url?: string;
  }>;
}

const { allTools } = Astro.props;

// Prepare compact client-side tools index (< 50KB JSON)
const clientToolsIndex = allTools.map(t => ({
  i: t.id,
  n: t.name,
  t: t.tagline,
  c: t.category,
  p: t.pricing_model,
  s: t.signal_score || 85,
  sh: Boolean(t.is_self_hostable),
  ns: Boolean(t.no_signup_required),
  alt: t.primary_alternative || '',
  st: t.stars || 0
}));
---

<section class="copilot-master-container" id="radar-ai-copilot">
  <div class="copilot-card">
    <!-- Header with AI Status & Pulse -->
    <div class="copilot-header">
      <div class="copilot-badge-row">
        <span class="ai-live-pill">
          <span class="ai-sparkle">✨</span>
          <span>RADAR AI ARCHITECTURAL COPILOT</span>
        </span>
        <span class="ai-status-tag">
          <span class="pulse-dot"></span>
          <span>Local Engine Active • Zero Latency</span>
        </span>
      </div>

      <h2 class="copilot-heading">
        Ask Radar AI: <span class="gradient-text">Instant Software Architecture Advisory</span>
      </h2>
      <p class="copilot-subtext">
        Describe your engineering constraints, stack preferences, or commercial alternatives. Radar's zero-cost semantic inference will cross-examine 840+ indexed developer tools to recommend production-ready fits.
      </p>
    </div>

    <!-- Quick Scenario Prompts Bar -->
    <div class="quick-prompts-row">
      <span class="prompts-label">Quick Scenarios:</span>
      <div class="prompts-scroll-wrapper">
        <button type="button" class="scenario-pill" data-query="docker self hosted notion alternative">
          🐳 Self-Hosted Notion Alt
        </button>
        <button type="button" class="scenario-pill" data-query="autonomous ai coding agent terminal cli">
          🤖 Autonomous Coding Agents
        </button>
        <button type="button" class="scenario-pill" data-query="open source supabase firebase alternative database">
          🗄️ Open Source Backends
        </button>
        <button type="button" class="scenario-pill" data-query="zero signup free developer productivity tools">
          🔓 No-Signup Utilities
        </button>
        <button type="button" class="scenario-pill" data-query="api web scraping proxy bypass automated extract">
          🌐 Headless Web Scraping
        </button>
      </div>
    </div>

    <!-- Interactive Prompt Input Bar -->
    <div class="copilot-input-wrapper">
      <div class="input-lens-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <input 
        type="text" 
        id="copilot-input" 
        class="copilot-input" 
        placeholder="e.g. 'I need a self-hostable monitoring tool with Docker' or 'Alternative to Buffer for social scheduling'..." 
        autocomplete="off"
      />
      <button type="button" id="copilot-submit-btn" class="copilot-btn">
        <span class="btn-text">Consult AI</span>
        <span class="btn-arrow">→</span>
      </button>
    </div>

    <!-- AI Output Canvas (Streaming Response + Recommended Cards) -->
    <div id="copilot-output-canvas" class="copilot-output-canvas" style="display: none;">
      <!-- Thinking status indicator -->
      <div id="copilot-thinking" class="copilot-thinking" style="display: none;">
        <div class="thinking-spinner"></div>
        <span id="thinking-step-text" class="thinking-step-text">Parsing architectural constraints...</span>
      </div>

      <!-- Generated AI Narrative Analysis -->
      <div id="copilot-narrative-box" class="copilot-narrative-box" style="display: none;">
        <div class="narrative-header">
          <div class="ai-avatar-badge">🧠 Radar Copilot Synthesis</div>
          <span class="match-meta" id="copilot-match-meta">Analyzed 840+ software dossiers</span>
        </div>
        <p id="copilot-stream-text" class="copilot-stream-text"></p>
      </div>

      <!-- Recommendations Cards Grid -->
      <div id="copilot-recommendations-grid" class="copilot-recommendations-grid" style="display: none;">
        <!-- Dynamic recommendation cards injected by client JS -->
      </div>
    </div>
  </div>
</section>

<!-- Embedded Tools Dataset for Instant Client-Side Zero-Cost Inference -->
<script is:inline define:vars={{ clientToolsIndex }}>
  window.__RADAR_TOOLS_INDEX__ = clientToolsIndex;
</script>

<script>
  // Client-Side Zero-Cost Pseudo-AI Inference Engine
  document.addEventListener('DOMContentLoaded', () => {
    const tools = (window as any).__RADAR_TOOLS_INDEX__ || [];
    const inputEl = document.getElementById('copilot-input') as HTMLInputElement | null;
    const submitBtn = document.getElementById('copilot-submit-btn');
    const canvas = document.getElementById('copilot-output-canvas');
    const thinkingBox = document.getElementById('copilot-thinking');
    const thinkingText = document.getElementById('thinking-step-text');
    const narrativeBox = document.getElementById('copilot-narrative-box');
    const streamText = document.getElementById('copilot-stream-text');
    const matchMeta = document.getElementById('copilot-match-meta');
    const grid = document.getElementById('copilot-recommendations-grid');
    const scenarioPills = document.querySelectorAll('.scenario-pill');

    if (!inputEl || !submitBtn || !canvas || !thinkingBox || !narrativeBox || !streamText || !grid) {
      return;
    }

    let isThinking = false;
    let streamTimer: any = null;

    // Intelligent Semantic Matching & Rule-based Scoring Engine
    function queryCopilot(rawQuery: string) {
      const q = rawQuery.toLowerCase().trim();
      if (!q || isThinking) return;

      isThinking = true;
      if (streamTimer) clearInterval(streamTimer);

      // Show canvas & reset states
      canvas.style.display = 'block';
      thinkingBox.style.display = 'flex';
      narrativeBox.style.display = 'none';
      grid.style.display = 'none';
      grid.innerHTML = '';
      streamText.innerHTML = '';

      // Smooth scroll to canvas view
      canvas.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      // Step 1: Thinking transition (Zero API, instant UX simulation)
      const steps = [
        "Synthesizing query constraints & developer taxonomy...",
        "Evaluating Docker, licensing & data sovereignty flags...",
        "Cross-ranking 840+ candidate dossiers..."
      ];
      let stepIdx = 0;
      if (thinkingText) thinkingText.innerText = steps[0];

      const stepInterval = setInterval(() => {
        stepIdx++;
        if (stepIdx < steps.length && thinkingText) {
          thinkingText.innerText = steps[stepIdx];
        }
      }, 180);

      setTimeout(() => {
        clearInterval(stepInterval);
        thinkingBox.style.display = 'none';

        // Perform semantic matching
        const results = matchTools(q);
        renderResponse(q, results);
        isThinking = false;
      }, 650);
    }

    function matchTools(q: string) {
      const tokens = q.split(/[\s,+/]+/).filter(w => w.length > 1);

      // Intent flags
      const wantsSelfHost = /self[\s-]?host|docker|bare[\s-]?metal|on[\s-]?prem|privacy|local/i.test(q);
      const wantsOss = /open[\s-]?source|oss|free|perpetual|no[\s-]?lock[\s-]?in/i.test(q);
      const wantsNoSignup = /no[\s-]?signup|no[\s-]?credit[\s-]?card|free[\s-]?trial|instant/i.test(q);
      const wantsAgent = /agent|coding|ai|llm|swe|assistant|copilot|autonomous/i.test(q);
      const wantsScrape = /scrape|scraper|crawl|browser|puppeteer|extract|proxy/i.test(q);
      const wantsDb = /database|postgres|sqlite|redis|backend|supabase|firebase/i.test(q);
      const wantsNotion = /notion|wiki|docs|knowledge|note/i.test(q);

      const scored = tools.map((t: any) => {
        let score = 0;
        const nameL = t.n.toLowerCase();
        const tagL = t.t.toLowerCase();
        const catL = t.c.toLowerCase();
        const altL = (t.alt || '').toLowerCase();

        // Exact name or alternative match
        if (nameL.includes(q) || (altL && q.includes(altL))) score += 40;
        if (altL && altL.includes(q)) score += 35;

        // Token match
        for (const tok of tokens) {
          if (nameL.includes(tok)) score += 15;
          if (altL.includes(tok)) score += 12;
          if (tagL.includes(tok)) score += 8;
          if (catL.includes(tok)) score += 10;
        }

        // Feature boosts
        if (wantsSelfHost && t.sh) score += 20;
        if (wantsOss && t.p === 'Open Source') score += 18;
        if (wantsNoSignup && t.ns) score += 15;
        if (wantsAgent && (catL.includes('ai-agent') || tagL.includes('agent'))) score += 20;
        if (wantsScrape && (catL.includes('scraping') || tagL.includes('scrap'))) score += 25;
        if (wantsDb && (catL.includes('database') || tagL.includes('database'))) score += 25;
        if (wantsNotion && (altL.includes('notion') || tagL.includes('notion') || nameL.includes('notion'))) score += 30;

        // Baseline quality boost
        score += (t.s || 80) * 0.1;
        score += Math.min(10, (t.st || 0) / 1000);

        return { tool: t, score };
      });

      scored.sort((a: any, b: any) => b.score - a.score);
      return scored.slice(0, 3);
    }

    function renderResponse(query: string, matches: any[]) {
      narrativeBox.style.display = 'block';
      grid.style.display = 'grid';

      const topMatch = matches[0]?.tool;
      const count = matches.length;

      // Construct realistic AI advisory prose
      let analysisText = "";
      if (topMatch) {
        analysisText = `Based on your architectural query ("${query}"), Radar's intelligence engine cross-referenced ${tools.length} software candidates. Our top recommended deployment is **${topMatch.n}** (${topMatch.p}${topMatch.sh ? ', Self-Hostable' : ''}), which delivers tailored ergonomics with a verified Signal Score of **${topMatch.s}/100**. ${topMatch.alt ? `It directly addresses vendor friction associated with **${topMatch.alt}**.` : 'It offers production-grade architectural simplicity with zero telemetry overhead.'} Below are the top verified selections matching your constraints:`;
      } else {
        analysisText = `Radar Copilot evaluated your query against 840+ software dossiers. We prioritized solutions offering strong community momentum, flexible deployment topologies, and transparent licensing. Review the curated selections below:`;
      }

      if (matchMeta) {
        matchMeta.innerText = `Verified ${count} Architectural Fit${count > 1 ? 's' : ''}`;
      }

      // Typewriter streaming effect (ultra-realistic, 0 cost)
      let charIdx = 0;
      streamText.innerHTML = '';
      streamTimer = setInterval(() => {
        if (charIdx < analysisText.length) {
          const nextChar = analysisText.charAt(charIdx);
          streamText.innerHTML = analysisText.slice(0, charIdx + 1).replace(/\*\*(.*?)\*\*/g, '<strong style="color: #38bdf8;">$1</strong>');
          charIdx += 3; // stream 3 chars per tick for smooth natural speed
        } else {
          clearInterval(streamTimer);
          streamText.innerHTML = analysisText.replace(/\*\*(.*?)\*\*/g, '<strong style="color: #38bdf8;">$1</strong>');
        }
      }, 15);

      // Render cards
      grid.innerHTML = '';
      matches.forEach((item: any, idx: number) => {
        const t = item.tool;
        const card = document.createElement('div');
        card.className = 'copilot-tool-card';
        card.innerHTML = `
          <div class="tool-card-head">
            <div class="match-badge">
              <span class="match-rank">#${idx + 1} Best Fit</span>
              <span class="match-pct">${Math.max(91, 99 - idx * 3)}% Match</span>
            </div>
            <span class="signal-tag">⚡ ${t.s}/100</span>
          </div>

          <h3 class="tool-card-name">
            <a href="/tool/${t.i}">${t.n}</a>
          </h3>
          <p class="tool-card-tagline">${t.t}</p>

          <div class="tool-card-badges">
            <span class="pill-badge ${t.p === 'Open Source' ? 'oss' : 'commercial'}">${t.p}</span>
            ${t.sh ? '<span class="pill-badge self-host">🐳 Self-Hostable</span>' : ''}
            ${t.ns ? '<span class="pill-badge no-signup">🔓 Zero Sign-up</span>' : ''}
            ${t.alt ? `<span class="pill-badge alt">Alt to ${t.alt}</span>` : ''}
          </div>

          <div class="tool-card-footer">
            <a href="/tool/${t.i}" class="btn-dossier">Read Architecture Dossier →</a>
            <a href="https://lordorange.top/tool/${t.i}" class="btn-inspect">Direct Link ↗</a>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    // Event listeners
    submitBtn.addEventListener('click', () => {
      queryCopilot(inputEl.value);
    });

    inputEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        queryCopilot(inputEl.value);
      }
    });

    scenarioPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        const btn = e.currentTarget as HTMLElement;
        const q = btn.getAttribute('data-query') || '';
        inputEl.value = btn.innerText.replace(/^[^\w\s]+/, '').trim();
        queryCopilot(q);
      });
    });
  });
</script>

<style>
  .copilot-master-container {
    margin: 2rem 0 3.5rem;
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .copilot-card {
    background: linear-gradient(135deg, rgba(14, 19, 30, 0.9) 0%, rgba(8, 10, 16, 0.95) 100%);
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 20px;
    padding: 2.25rem 2rem;
    position: relative;
    overflow: hidden;
    box-shadow: 0 16px 48px -10px rgba(0, 0, 0, 0.7), 0 0 32px -4px rgba(56, 189, 248, 0.15);
  }

  @media (max-width: 640px) {
    .copilot-card {
      padding: 1.5rem 1rem;
      border-radius: 14px;
    }
  }

  .copilot-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #38bdf8, #a855f7, transparent);
  }

  .copilot-header {
    margin-bottom: 1.75rem;
  }

  .copilot-badge-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }

  .ai-live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #38bdf8;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }

  .ai-status-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    color: #10b981;
    font-weight: 600;
    background: rgba(16, 185, 129, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: pulse-glow 2s infinite;
  }

  @keyframes pulse-glow {
    0% { transform: scale(0.9); opacity: 0.8; }
    50% { transform: scale(1.2); opacity: 1; }
    100% { transform: scale(0.9); opacity: 0.8; }
  }

  .copilot-heading {
    font-size: clamp(1.4rem, 3.2vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #ffffff;
    line-height: 1.25;
    margin-bottom: 0.65rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .copilot-subtext {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 820px;
    margin: 0;
  }

  /* Quick Scenarios */
  .quick-prompts-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .prompts-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .prompts-scroll-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .scenario-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: var(--text-secondary);
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .scenario-pill:hover {
    background: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.35);
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* Input Bar */
  .copilot-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background: #090b12;
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: 12px;
    padding: 0.4rem 0.45rem 0.4rem 2.85rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .input-lens-icon {
    position: absolute;
    left: 1rem;
    color: #38bdf8;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .copilot-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 0.95rem;
    font-family: inherit;
    min-width: 0;
  }

  .copilot-input::placeholder {
    color: #52525b;
    font-size: 0.88rem;
  }

  .copilot-btn {
    background: linear-gradient(135deg, #38bdf8 0%, #6366f1 100%);
    border: none;
    color: #040812;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .copilot-btn:hover {
    filter: brightness(1.15);
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.4);
  }

  /* Output Canvas */
  .copilot-output-canvas {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .copilot-thinking {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: rgba(56, 189, 248, 0.05);
    border: 1px dashed rgba(56, 189, 248, 0.3);
    border-radius: 10px;
    margin-bottom: 1.25rem;
  }

  .thinking-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(56, 189, 248, 0.2);
    border-top-color: #38bdf8;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .thinking-step-text {
    font-size: 0.85rem;
    color: #7dd3fc;
    font-family: var(--font-mono);
  }

  /* Narrative Box */
  .copilot-narrative-box {
    background: rgba(18, 22, 34, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .narrative-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ai-avatar-badge {
    font-size: 0.82rem;
    font-weight: 700;
    color: #38bdf8;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .match-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .copilot-stream-text {
    font-size: 0.96rem;
    line-height: 1.7;
    color: #e4e4e7;
    margin: 0;
  }

  /* Recommendation Cards Grid */
  .copilot-recommendations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .copilot-tool-card {
    background: #0d101a;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .copilot-tool-card:hover {
    border-color: rgba(56, 189, 248, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .tool-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
  }

  .match-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .match-rank {
    font-size: 0.7rem;
    font-weight: 800;
    color: #6ee7b7;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
  }

  .match-pct {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .signal-tag {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: #facc15;
    font-weight: 700;
  }

  .tool-card-name {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.35rem;
  }

  .tool-card-name a {
    color: #ffffff;
    text-decoration: none;
  }

  .tool-card-name a:hover {
    color: #38bdf8;
  }

  .tool-card-tagline {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tool-card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .pill-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

