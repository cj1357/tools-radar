# Tools Radar - AI Configuration
# Compatible with New API / One API / OpenAI / Google AI Studio

# 1. New API Base URL (usually ends with /v1, e.g. https://api.yourdomain.com/v1)
AI_API_BASE=https://your-new-api-domain.com/v1

# 2. Your API Key (Generated in New API -> Tokens, starts with sk-...)
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Model name configured in New API
# Recommendation: use Flash Lite (e.g. google/gemini-3.5-flash-lite) to take advantage of 15 RPM / 500 RPD free tier
AI_MODEL=google/gemini-3.5-flash-lite
